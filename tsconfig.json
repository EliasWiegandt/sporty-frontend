{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {},
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "preact",
    "allowJs": true,
    "checkJs": false,
    "types": ["astro/client"],
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
