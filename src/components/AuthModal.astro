---
---
<div id="auth-modal" class="hs-overlay hidden size-full fixed top-0 start-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none">
  <div class="hs-overlay-open:mt-7 hs-overlay-open:opacity-100 hs-overlay-open:duration-500 mt-0 opacity-0 ease-out transition-all sm:max-w-lg sm:w-full m-3 sm:mx-auto min-h-[calc(100%-3.5rem)] flex items-center">
    <div class="w-full flex flex-col bg-white border border-slate-200 shadow-sm rounded-xl pointer-events-auto">
      <div class="p-4 sm:p-7">
        <div class="text-center">
          <h2 class="block text-2xl font-bold text-slate-900" data-auth-title>Log in</h2>
          <p class="mt-2 text-sm text-slate-600">
            <span data-auth-switch-text>Don't have an account yet?</span>
            <button type="button" class="text-teal-600 decoration-2 hover:underline font-medium" data-auth-switch>
              Sign up here
            </button>
          </p>
        </div>

        <div class="mt-5">
          <!-- Status Message -->
          <div id="auth-status" class="hidden mb-4 bg-teal-50 border border-teal-200 text-sm text-teal-800 rounded-lg p-4" role="alert">
            <span data-auth-status-text></span>
          </div>

          <!-- Form -->
          <form data-auth-form>
            <div class="grid gap-y-4">
              <!-- Email -->
              <div>
                <label for="auth-email" class="block text-sm mb-2 font-medium text-slate-700">Email address</label>
                <div class="relative">
                  <input type="email" id="auth-email" name="email" class="input-field" required autocomplete="email" placeholder="you@example.com">
                </div>
              </div>

              <!-- Password -->
              <div>
                <label for="auth-password" class="block text-sm mb-2 font-medium text-slate-700">Password</label>
                <div class="relative">
                  <input type="password" id="auth-password" name="password" class="input-field" required autocomplete="current-password" minlength="6" placeholder="••••••••">
                </div>
              </div>

              <div class="hidden grid gap-y-3" data-signup-legal-row>
                <label class="block">
                  <span class="block text-sm mb-2 font-medium text-slate-700">Country of residence</span>
                  <select id="signup-country" name="country_of_residence" class="input-field" data-signup-country>
                    <option value="">Select country…</option>
                    <option value="US">United States</option>
                    <option value="AT">Austria</option>
                    <option value="BE">Belgium</option>
                    <option value="BG">Bulgaria</option>
                    <option value="HR">Croatia</option>
                    <option value="CY">Cyprus</option>
                    <option value="CZ">Czechia</option>
                    <option value="DK">Denmark</option>
                    <option value="EE">Estonia</option>
                    <option value="FI">Finland</option>
                    <option value="FR">France</option>
                    <option value="DE">Germany</option>
                    <option value="GR">Greece</option>
                    <option value="HU">Hungary</option>
                    <option value="IE">Ireland</option>
                    <option value="IT">Italy</option>
                    <option value="LV">Latvia</option>
                    <option value="LT">Lithuania</option>
                    <option value="LU">Luxembourg</option>
                    <option value="MT">Malta</option>
                    <option value="NL">Netherlands</option>
                    <option value="PL">Poland</option>
                    <option value="PT">Portugal</option>
                    <option value="RO">Romania</option>
                    <option value="SK">Slovakia</option>
                    <option value="SI">Slovenia</option>
                    <option value="ES">Spain</option>
                    <option value="SE">Sweden</option>
                  </select>
                </label>
                <p class="text-xs text-slate-500">
                  Sporty currently supports signups only in the EU and United States.
                </p>
                <div class="flex items-start">
                  <div class="flex items-center h-5">
                    <input id="signup-terms-accept" name="signup_terms_accept" type="checkbox" class="border-slate-200 rounded text-teal-600 focus:ring-teal-500" data-signup-terms-accept>
                  </div>
                  <label for="signup-terms-accept" class="ms-3 text-sm text-slate-600">
                    I agree to the <a href="/terms" target="_blank" rel="noopener noreferrer" class="text-teal-600 decoration-2 hover:underline font-medium">Terms of Service</a>
                  </label>
                </div>
                <div class="flex items-start">
                  <div class="flex items-center h-5">
                    <input id="signup-privacy-accept" name="signup_privacy_accept" type="checkbox" class="border-slate-200 rounded text-teal-600 focus:ring-teal-500" data-signup-privacy-accept>
                  </div>
                  <label for="signup-privacy-accept" class="ms-3 text-sm text-slate-600">
                    I acknowledge the <a href="/privacy" target="_blank" rel="noopener noreferrer" class="text-teal-600 decoration-2 hover:underline font-medium">Privacy Notice</a>
                  </label>
                </div>
                <div class="flex items-start">
                  <div class="flex items-center h-5">
                    <input id="signup-age-attestation" name="signup_age_attestation" type="checkbox" class="border-slate-200 rounded text-teal-600 focus:ring-teal-500" data-signup-age-attestation>
                  </div>
                  <label for="signup-age-attestation" class="ms-3 text-sm text-slate-600">
                    I confirm I am at least 18 year old.
                  </label>
                </div>
              </div>

              <div class="hidden" data-auth-reset-row>
                <button
                  type="button"
                  class="text-teal-600 text-sm font-medium hover:underline"
                  data-auth-reset
                >
                  Reset password
                </button>
              </div>

              <button type="submit" class="btn-pill btn-pill-primary w-full py-3 justify-center" data-auth-submit>Log in</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
