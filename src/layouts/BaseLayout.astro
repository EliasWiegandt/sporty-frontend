---
import '../styles/tailwind.css';
import AuthModal from '../components/AuthModal.astro';

interface NavLink {
  href: string;
  label: string;
  external?: boolean;
}

interface NavAction {
  href: string;
  label: string;
  variant?: 'solid' | 'ghost';
  size?: 'md' | 'sm';
}

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  bodyClass?: string;
  navLabel?: string;
  navLinks?: NavLink[];
  primaryAction?: NavAction | null;
  secondaryAction?: NavAction | null;
  showAuth?: boolean;
  showHeader?: boolean;
}

const defaultNavLinks: NavLink[] = [
  { href: '/#science', label: 'About' },
  { href: '/#tiers', label: 'Pricing' },
  { href: '/science', label: 'Science' },
  { href: '/dashboard', label: 'Dashboard' },
];

const defaultPrimaryAction: NavAction = { href: '/intake', label: 'Try free analysis' };

const {
  title = 'Sporty',
  description = 'Discover sports that fit your body with Sporty.',
  canonical,
  bodyClass = '',
  navLabel = 'Primary',
  navLinks: navLinksProp,
  primaryAction: primaryActionProp,
  secondaryAction = null,
  showAuth = true,
  showHeader = true,
} = Astro.props as Props;

const navLinks = navLinksProp ?? defaultNavLinks;
const primaryAction = primaryActionProp ?? defaultPrimaryAction;

const actions = [primaryAction, secondaryAction].filter(
  (action): action is NavAction => Boolean(action)
);

const hasNavContent = navLinks.length > 0;
const hasActionContent = actions.length > 0 || showAuth;

---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="data:," />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="https://code.iconify.design/iconify-icon/1.0.8/iconify-icon.min.js" defer></script>
    <script is:inline src="/config.js"></script>
    <script is:inline src="/assets/js/app.js?v=6" defer></script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    {showHeader && (
      <header class="sticky top-0 z-50 border-b border-slate-200/60 bg-slate-50/90 backdrop-blur-md">
        <nav
          class="mx-auto flex w-full max-w-[min(96rem,92vw)] items-center justify-between gap-3 px-4 py-4 sm:gap-4 md:px-6"
          aria-label={navLabel}
        >
          <a
            href="/"
            class="group inline-flex items-center gap-2 rounded-full px-3 py-1 type-lead tracking-tight font-semibold text-[clamp(1.5rem,1.2rem+1vw,2rem)] text-slate-900 transition-colors hover:bg-teal-100/60 hover:text-teal-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500 focus-visible:ring-offset-2"
            aria-label="Sporty home"
          >
            <iconify-icon
              icon="mingcute:laurel-wreath-fill"
              class="pointer-events-none text-[1.45em] text-[#0a5f2a] transition-transform duration-150 ease-in-out group-hover:scale-105 group-hover:text-teal-600 group-focus-visible:scale-105 group-focus-visible:text-teal-600"
              aria-hidden="true"
            ></iconify-icon>
            <span class="leading-tight no-underline">sporty</span>
          </a>

          {hasNavContent && (
            <div class="flex items-center gap-5">
              {navLinks.map((link) => (
                <a
                  href={link.href}
                  class="type-body font-medium text-slate-600 transition-colors hover:text-teal-700"
                  rel={link.external ? 'noreferrer noopener' : undefined}
                  target={link.external ? '_blank' : undefined}
                >
                  {link.label}
                </a>
              ))}
            </div>
          )}

          {hasActionContent && (
            <div class="flex items-center gap-3 md:gap-4">
              {actions.map((action) => {
                const isGhost = action.variant === 'ghost';
                const classes = ['btn-pill'];
                classes.push(isGhost ? 'btn-pill-secondary' : 'btn-pill-primary');
                if (action.size === 'sm') {
                  classes.push('btn-sm');
                }
                return (
                  <a href={action.href} class={classes.filter(Boolean).join(' ')}>
                    {action.label}
                  </a>
                );
              })}
              {showAuth && (
                <div class="inline-flex items-center gap-2" data-auth-controls>
                  <button
                    class="btn-pill btn-pill-secondary btn-sm"
                    type="button"
                    data-auth-open
                    data-auth-mode="signin"
                  >
                    Sign up / Log in
                  </button>
                  <button
                    class="btn-pill btn-pill-secondary btn-sm"
                    type="button"
                    data-auth-signout
                    hidden
                  >
                    Log out
                  </button>
                </div>
              )}
            </div>
          )}
        </nav>
      </header>
    )}
    <slot />
    <AuthModal />
    <script>
      (function () {
        const globalWindow = window as unknown as Window & Record<string, unknown>;
        const FLAG = '__sportyPrelineReady';
        const HOOKED = '__sportyPrelineListeners';
        const autoInit = () => {
          const methods = globalWindow.HSStaticMethods as { autoInit?: () => void } | undefined;
          if (methods && typeof methods.autoInit === 'function') {
            methods.autoInit();
          }
        };
        (globalWindow as any).__sportyPrelineStart = function () {
          if ((globalWindow[FLAG] as boolean)) {
            autoInit();
            return;
          }
          globalWindow[FLAG] = true;
          autoInit();
          if (!(globalWindow[HOOKED] as boolean)) {
            globalWindow[HOOKED] = true;
            document.addEventListener('astro:page-load', autoInit);
            document.addEventListener('astro:after-swap', autoInit);
          }
        };
      })();
    </script>
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/preline@3.2.3/dist/preline.js"
      defer
      onload="window.__sportyPrelineStart && window.__sportyPrelineStart();"
    ></script>
    <slot name="scripts" />
  </body>
</html>
