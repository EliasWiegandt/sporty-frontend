---
import '../styles/tailwind.css';
import AuthModal from '../components/AuthModal.astro';

interface NavLink {
  href: string;
  label: string;
  external?: boolean;
}

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  bodyClass?: string;
  navLabel?: string;
  navLinks?: NavLink[];
  showAuth?: boolean;
  showHeader?: boolean;
}

const defaultNavLinks: NavLink[] = [
  { href: '/#science', label: 'Why it works' },
  { href: '/#tiers', label: 'Pricing' },
  { href: '/science', label: 'Science' },
  { href: '/premium', label: 'Premium analyses' },
  { href: '/dashboard', label: 'Dashboard' },
];

const {
  title = 'Sporty',
  description = 'Discover sports that fit your body with Sporty.',
  canonical,
  bodyClass = '',
  navLabel = 'Primary',
  navLinks: navLinksProp,
  showAuth = true,
  showHeader = true,
} = Astro.props as Props;

const navLinks = navLinksProp ?? defaultNavLinks;

const hasNavContent = navLinks.length > 0;
const mobileMenuId = 'primary-nav-mobile';

---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="data:," />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline src="https://code.iconify.design/iconify-icon/1.0.8/iconify-icon.min.js" defer></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" defer></script>
    <script is:inline src="/config.js" defer></script>
    <script is:inline src="/assets/js/app.js?v=13" defer></script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    {showHeader && (
      <header class="sticky top-0 z-50 border-b border-slate-200/60 bg-slate-50/90 backdrop-blur-md">
        <nav
          class="mx-auto flex w-full max-w-[min(96rem,92vw)] flex-wrap items-center justify-between gap-3 px-4 py-4 sm:gap-4 md:px-6"
          aria-label={navLabel}
        >
          <a
            href="/"
            class="group inline-flex items-center gap-2 rounded-full px-3 py-1 type-lead tracking-tight font-semibold text-[clamp(1.5rem,1.2rem+1vw,2rem)] text-slate-900 transition-colors hover:bg-teal-100/60 hover:text-teal-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500 focus-visible:ring-offset-2"
            aria-label="Sporty home"
          >
            <iconify-icon
              icon="mingcute:laurel-wreath-fill"
              class="pointer-events-none text-[1.45em] text-[#0a5f2a] transition-transform duration-150 ease-in-out group-hover:scale-105 group-hover:text-teal-600 group-focus-visible:scale-105 group-focus-visible:text-teal-600"
              aria-hidden="true"
            ></iconify-icon>
            <span class="leading-tight no-underline">sporty</span>
          </a>

          <div class="ml-auto flex items-center gap-2 md:hidden">
            {showAuth && (
              <div class="inline-flex items-center gap-2" data-auth-controls>
                <button
                  class="btn-pill btn-pill-secondary btn-pill-sm"
                  type="button"
                  data-auth-open
                  data-auth-mode="signin"
                >
                  Sign up / Log in
                </button>
                <button
                  class="btn-pill btn-pill-secondary btn-pill-sm"
                  type="button"
                  data-auth-signout
                  hidden
                >
                  Log out
                </button>
              </div>
            )}
            <button
              type="button"
              class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full border border-slate-200 bg-white px-3 text-slate-800 shadow-sm transition hover:border-teal-300 hover:text-teal-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-teal-500 focus-visible:ring-offset-2"
              data-mobile-nav-toggle
              aria-expanded="false"
              aria-controls={mobileMenuId}
              aria-label="Open navigation menu"
            >
              <span class="sr-only">Menu</span>
              <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5">
                <path d="M4 7h16M4 12h16M4 17h16" fill="none" stroke="currentColor" stroke-linecap="round" stroke-width="1.75"></path>
              </svg>
            </button>
          </div>

          <div class="hidden items-center gap-5 md:flex">
            {hasNavContent && navLinks.map((link) => (
              <a
                href={link.href}
                class="type-body font-medium text-slate-600 transition-colors hover:text-teal-700"
                rel={link.external ? 'noreferrer noopener' : undefined}
                target={link.external ? '_blank' : undefined}
              >
                {link.label}
              </a>
            ))}
          </div>

          <div class="hidden items-center gap-3 md:flex md:gap-4">
            {showAuth && (
              <div class="inline-flex items-center gap-2" data-auth-controls>
                <button
                  class="btn-pill btn-pill-secondary btn-pill-sm"
                  type="button"
                  data-auth-open
                  data-auth-mode="signin"
                >
                  Sign up / Log in
                </button>
                <button
                  class="btn-pill btn-pill-secondary btn-pill-sm"
                  type="button"
                  data-auth-signout
                  hidden
                >
                  Log out
                </button>
              </div>
            )}
          </div>

          <div
            id={mobileMenuId}
            class="hidden w-full rounded-[1.75rem] border border-slate-200/80 bg-white/95 p-4 shadow-lg md:hidden"
            data-mobile-nav-panel
          >
            <div class="flex flex-col gap-3">
              {hasNavContent && navLinks.map((link) => (
                <a
                  href={link.href}
                  class="rounded-2xl px-3 py-3 type-body font-medium text-slate-700 transition-colors hover:bg-teal-50 hover:text-teal-700"
                  rel={link.external ? 'noreferrer noopener' : undefined}
                  target={link.external ? '_blank' : undefined}
                >
                  {link.label}
                </a>
              ))}
            </div>
          </div>
        </nav>
      </header>
    )}
    <slot />
    <AuthModal />
    {showHeader && (
      <script is:inline>
        (() => {
          const toggle = document.querySelector('[data-mobile-nav-toggle]');
          const panel = document.querySelector('[data-mobile-nav-panel]');
          if (!(toggle instanceof HTMLButtonElement) || !(panel instanceof HTMLElement)) {
            return;
          }

          const closeMenu = () => {
            toggle.setAttribute('aria-expanded', 'false');
            toggle.setAttribute('aria-label', 'Open navigation menu');
            panel.classList.add('hidden');
          };

          const openMenu = () => {
            toggle.setAttribute('aria-expanded', 'true');
            toggle.setAttribute('aria-label', 'Close navigation menu');
            panel.classList.remove('hidden');
          };

          toggle.addEventListener('click', () => {
            const expanded = toggle.getAttribute('aria-expanded') === 'true';
            if (expanded) {
              closeMenu();
            } else {
              openMenu();
            }
          });

          panel.querySelectorAll('a').forEach((link) => {
            link.addEventListener('click', closeMenu);
          });

          window.addEventListener('resize', () => {
            if (window.innerWidth >= 768) {
              closeMenu();
            }
          });
        })();
      </script>
    )}
    <slot name="scripts" />
  </body>
</html>
