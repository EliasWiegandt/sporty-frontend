---
import '../styles/global.css';
import '../styles/webcore.scss';
import { Button } from 'webcoreui/astro';

interface NavLink {
  href: string;
  label: string;
  external?: boolean;
}

interface NavAction {
  href: string;
  label: string;
  variant?: 'solid' | 'ghost';
  size?: 'md' | 'sm';
}

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  bodyClass?: string;
  navLabel?: string;
  navLinks?: NavLink[];
  primaryAction?: NavAction | null;
  secondaryAction?: NavAction | null;
  showAuth?: boolean;
  showHeader?: boolean;
}

const defaultNavLinks: NavLink[] = [
  { href: '/about', label: 'About' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/dashboard', label: 'Dashboard' },
];

const defaultPrimaryAction: NavAction = { href: '/intake', label: 'Start free' };

const {
  title = 'Sporty',
  description = 'Discover sports that fit your body with Sporty.',
  canonical,
  bodyClass = '',
  navLabel = 'Primary',
  navLinks: navLinksProp,
  primaryAction: primaryActionProp,
  secondaryAction = null,
  showAuth = true,
  showHeader = true,
} = Astro.props as Props;

const navLinks = navLinksProp ?? defaultNavLinks;
const primaryAction = primaryActionProp ?? defaultPrimaryAction;

const actions = [primaryAction, secondaryAction].filter(
  (action): action is NavAction => Boolean(action)
);

const hasNavContent = navLinks.length > 0;
const hasActionContent = actions.length > 0 || showAuth;

const buttonTheme = (variant?: NavAction['variant']) =>
  variant === 'ghost' ? 'outline' : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="data:," />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Nunito:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    {showHeader && (
      <header class="site-header">
        <nav class="nav-container" aria-label={navLabel}>
          <a
            href="/"
            class="group inline-flex items-center gap-1.5 rounded-full px-3 py-1 text-[1.25rem] font-semibold tracking-tight text-[var(--gray-12)] transition-colors hover:bg-[rgba(14,165,165,0.12)] hover:text-[var(--teal-9)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--teal-7)] focus-visible:ring-offset-2"
            aria-label="Sporty home"
          >
            <i class="i-mingcute-laurel-wreath-fill pointer-events-none text-[1.45em] text-[#0a5f2a] transition-transform duration-150 ease-in-out group-hover:scale-105 group-hover:text-[var(--teal-8)] group-focus-visible:scale-105 group-focus-visible:text-[var(--teal-8)]" aria-hidden="true"></i>
            <span class="leading-tight">sporty</span>
          </a>
          {hasNavContent && (
            <div class="nav-links">
              {navLinks.map((link) => (
                <a href={link.href} rel={link.external ? 'noreferrer noopener' : undefined} target={link.external ? '_blank' : undefined}>
                  {link.label}
                </a>
              ))}
            </div>
          )}
          {hasActionContent && (
            <div class="nav-actions">
              {actions.map((action) => {
                const classes = ['nav-button'];
                if (action.size === 'sm') {
                  classes.push('nav-button--sm');
                }
                return (
                  <Button href={action.href} theme={buttonTheme(action.variant)} className={classes.join(' ')}>
                    {action.label}
                  </Button>
                );
              })}
              {showAuth && (
                <div class="nav-auth" data-auth-controls>
                  <Button
                    theme="outline"
                    className="nav-button nav-button--sm"
                    type="button"
                    data-auth-open
                    data-auth-mode="signin"
                  >
                    Log in
                  </Button>
                  <Button
                    theme="outline"
                    className="nav-button nav-button--sm"
                    type="button"
                    data-auth-signout
                    hidden
                  >
                    Log out
                  </Button>
                </div>
              )}
            </div>
          )}
        </nav>
      </header>
    )}
    <slot />
    <slot name="scripts" />
  </body>
</html>
