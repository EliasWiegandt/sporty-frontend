---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Sporty — Child Forecast Results"
  description="Review the projected adult measurements for your child and see how each source contributed."
>
  <main class="results-tabs" data-child-results-tabs-root>
    <nav class="results-tabs__bar" role="tablist" aria-label="Child results views">
      <button
        type="button"
        class="results-tabs__tab"
        role="tab"
        aria-selected="false"
        data-tab-button="matches"
      >
        Matches
      </button>
      <button
        type="button"
        class="results-tabs__tab"
        role="tab"
        aria-selected="true"
        data-tab-button="forecast"
      >
        Forecasted body
      </button>
    </nav>

    <section class="results-tabs__panel" data-tab-panel="matches" hidden>
      <div class="results-shell" data-premium-root>
        <header class="result-header anchored" data-premium-hero>
          <h1 class="section-title">Your Premium Matches</h1>
          <p class="cta-inline" data-reason>Based on your measurements and premium inputs.</p>
        </header>

        <div class="results-container" data-results-container></div>

        <div class="empty-state" data-empty-state hidden>
          <h2>No premium analysis loaded</h2>
          <p>Run a child analysis with a child credit to see detailed insights here.</p>
          <div class="btn-row justify-center">
            <a class="btn-primary" href="/child-intake">Run a child analysis</a>
            <button type="button" class="btn-secondary" data-tab-jump="forecast">View forecasted body</button>
          </div>
        </div>
      </div>
    </section>

    <section class="results-tabs__panel" data-tab-panel="forecast">
      <div class="grid gap-8" data-child-forecast-root>
        <header class="summary-card" data-summary hidden>
          <div>
            <h2 class="section-title" style="margin:0;">Forecasted body</h2>
            <p class="lead-copy" data-summary-copy></p>
          </div>
          <dl class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-summary-meta></dl>
        </header>

        <section class="grid gap-5" data-forecast-results hidden></section>

        <div
          class="grid gap-3 justify-items-center rounded-[18px] border border-dashed border-[rgba(148,163,184,0.35)] p-[clamp(1.6rem,3vw,2.2rem)] text-center text-[var(--gray-6)]"
          data-empty-state
        >
          <h2>No forecast loaded</h2>
          <p>Submit the child forecast form first. We keep the latest run locally so you can review it here.</p>
          <div class="btn-row justify-center">
            <a class="btn-primary" href="/child-intake">Back to intake</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <Fragment slot="scripts">
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" defer></script>
    <script is:inline src="/config.js" defer></script>
    <script is:inline src="/assets/js/app.js?v=4" defer></script>
    <script is:inline src="/assets/js/child-results-tabs.js" defer></script>
    <script is:inline src="/assets/js/child-results-premium-adapter.js" defer></script>
    <script is:inline src="/assets/js/child-results.js" defer></script>
    <script is:inline src="/assets/js/results-premium.js" defer></script>
  </Fragment>
</BaseLayout>
