---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Sporty — Child Forecast Results"
  description="Review the projected adult measurements for your child and see how each source contributed."
>
  <Fragment slot="head">
    <style>
      .contrib-table {
        width: 100%;
        border-collapse: collapse;
      }
      .contrib-table th,
      .contrib-table td {
        padding: 0.5rem 0.35rem;
        text-align: left;
      }
      .contrib-table tbody tr:nth-child(2n) {
        background: rgba(148, 163, 184, 0.1);
      }
    </style>
  </Fragment>

  <main class="section-shell grid gap-8">
    <header class="summary-card" data-summary hidden>
      <div>
        <h1 class="section-title" style="margin:0;">Child forecast</h1>
        <p class="lead-copy" data-summary-copy></p>
      </div>
      <dl class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-summary-meta>
      </dl>
    </header>

    <section class="grid gap-5" data-forecast-results hidden></section>

    <div
      class="grid gap-3 justify-items-center rounded-[18px] border border-dashed border-[rgba(148,163,184,0.35)] p-[clamp(1.6rem,3vw,2.2rem)] text-center text-[var(--gray-6)]"
      data-empty-state
    >
      <h2>No forecast loaded</h2>
      <p>Submit the child forecast form first. We keep the latest run locally so you can review it here.</p>
      <div class="btn-row justify-center">
        <a class="btn-primary" href="/child-intake">Back to intake</a>
      </div>
    </div>
  </main>

  <section class="card-teal grid-stack" data-premium-section hidden>
    <div class="grid gap-2">
      <span class="badge">Premium sport suggestions</span>
      <h2 class="section-title" data-premium-title>Premium analysis</h2>
      <p class="lead-copy" data-premium-reason>When a child credit is applied we’ll summarise premium sport matches here.</p>
      <div class="inline-flex flex-wrap items-center gap-3 text-sm text-[var(--gray-6)]" data-premium-credit hidden>
        <span class="pill-teal" data-premium-credit-adult>Adult credits: —</span>
        <span class="pill-teal" data-premium-credit-child>Child credits: —</span>
      </div>
    </div>
    <div class="grid-stack lg:grid-cols-[2fr_1fr]">
      <div class="grid-stack">
        <article class="card-measurement">
          <h3 class="card-title">Component impact</h3>
          <ul class="list-reset grid gap-[0.65rem]" data-premium-components></ul>
        </article>
        <article class="card-measurement">
          <h3 class="card-title">Preferences</h3>
          <ul class="list-reset grid gap-[0.65rem]" data-premium-preferences></ul>
        </article>
        <article class="card-measurement">
          <h3 class="card-title">Goals</h3>
          <ul class="list-reset grid gap-[0.65rem]" data-premium-goals></ul>
        </article>
        <article class="card-measurement">
          <h3 class="card-title">Injury considerations</h3>
          <ul class="list-reset grid gap-[0.65rem]" data-premium-injuries></ul>
        </article>
        <article class="card-measurement">
          <h3 class="card-title">Next actions</h3>
          <ul class="list-reset grid gap-[0.65rem]" data-premium-next-steps></ul>
        </article>
        <article class="card-measurement">
          <h3 class="card-title">Child past sports</h3>
          <ul class="list-reset grid gap-[0.65rem]" data-premium-past-sports></ul>
        </article>
      </div>
      <div class="grid-stack">
        <article class="card-measurement">
          <h3 class="card-title">Top sport matches</h3>
          <div class="grid gap-[0.65rem]" data-premium-matches></div>
        </article>
      </div>
    </div>
  </section>

  <section class="card-refine gap-3" data-premium-cta hidden>
    <h2 class="section-title" style="margin:0;">Get sports matches for this child</h2>
    <p class="lead-copy">Use the forecasted adult build as a starting point, then add preferences, goals, injuries, and past sports to unlock tailored sport matches.</p>
    <div class="flex flex-wrap items-center gap-4">
      <a class="btn-primary" href="/child-premium">Get sports matches for child</a>
      <a class="btn-ghost" href="/pricing">Buy more child credits</a>
    </div>
  </section>

  <Fragment slot="scripts">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" defer></script>
    <script src="/config.js" defer></script>
    <script src="/assets/js/app.js" defer></script>
    <script src="/assets/js/child-results.js" defer></script>
  </Fragment>
</BaseLayout>
