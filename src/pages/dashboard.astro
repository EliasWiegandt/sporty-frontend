---
import BaseLayout from '../layouts/BaseLayout.astro';

const historyPlaceholders = [
  {
    title: 'Adult premium analysis',
    date: '2025-09-28',
    summary: 'Highlighted trail running, rowing, and climbing with 68% body alignment.',
  },
  {
    title: 'Child forecast — Casey',
    date: '2025-08-12',
    summary: 'Projected 6’1” adult height, strong wingspan, suggested volleyball and swimming.',
  },
];
---
<BaseLayout title="Sporty — Dashboard" description="Review saved analyses, credit balances, and measurement locker." showAuth={true}>
  <main class="dashboard-shell" data-dashboard-root>
    <section class="dashboard-card dashboard-card--full" data-dashboard-signed-out>
      <div class="max-w-md mx-auto flex flex-col gap-6">
        <iconify-icon icon="mingcute:lock-fill" class="text-5xl text-teal-600 mx-auto"></iconify-icon>
        <div>
          <h1 class="section-title">Sign in to view your dashboard</h1>
          <p class="lead-copy mt-2">History, credits, and saved measurements live here. Sign in or create an account to continue.</p>
        </div>
        <div class="btn-row">
          <button class="btn-pill btn-pill-primary" type="button" data-auth-open data-auth-mode="signin">Log in</button>
          <button class="btn-pill btn-pill-secondary" type="button" data-auth-open data-auth-mode="signup">Create account</button>
        </div>
        <p class="text-sm text-slate-500 mt-4">
          <a href="/#tiers" class="hover:text-teal-700 underline">View pricing & plans</a>
        </p>
      </div>
    </section>

    <div class="dashboard-layout" data-dashboard-signed-in hidden>
      <aside class="dashboard-sidebar">
        <section class="dashboard-card" data-checkout-zone>
          <div class="flex items-center gap-2 mb-2">
            <iconify-icon icon="mingcute:wallet-4-fill" class="text-xl text-teal-600"></iconify-icon>
            <h2 class="type-title text-lg">Premium analysis credits</h2>
          </div>
          
          <div class="stat-grid">
            <div class="stat-card">
              <span class="stat-label">Premium Analysis</span>
              <span class="stat-value" data-credits-adult>—</span>
              <div class="flex flex-col gap-2 mt-auto">
                <button
                  class="btn-pill btn-pill-primary btn-pill-xs w-full justify-center"
                  type="button"
                  data-premium-run="adult"
                  data-premium-run-target="/intake-premium"
                >
                  Run analysis
                </button>
                <button
                  class="btn-pill btn-pill-secondary btn-pill-xs w-full justify-center"
                  type="button"
                  data-checkout-product="single_adult_analysis"
                  data-checkout-credit-type="adult"
                  data-checkout-context="adult"
                >
                  Buy analysis credit
                </button>
              </div>
            </div>
            <div class="stat-card">
              <span class="stat-label">Child Forecast and Analysis</span>
              <span class="stat-value" data-credits-child>—</span>
              <div class="flex flex-col gap-2 mt-auto">
                <button
                  class="btn-pill btn-pill-primary btn-pill-xs w-full justify-center"
                  type="button"
                  data-premium-run="child"
                  data-premium-run-target="/child-intake"
                >
                  Run analysis
                </button>
                <button
                  class="btn-pill btn-pill-secondary btn-pill-xs w-full justify-center"
                  type="button"
                  data-checkout-product="single_child_analysis"
                  data-checkout-credit-type="child"
                  data-checkout-context="child"
                >
                  Buy analysis credit
                </button>
              </div>
            </div>
          </div>
          <p class="credit-status text-sm text-center mt-2" data-checkout-status hidden></p>
        </section>

        <section class="dashboard-card">
          <div class="mb-4">
            <div class="badge-subtle mb-2">Saved analyses</div>
            <h2 class="type-title text-lg">Your history</h2>
          </div>
          <div class="history-grid" data-history-grid>
            <!-- History items will be loaded here by dashboard.js -->
          </div>
        </section>
      </aside>

      <section class="dashboard-content">
        <section class="dashboard-card">
          <header class="mb-6">
            <h1 class="section-title text-2xl mb-1">Account & Data</h1>
            <p class="lead-copy" data-profile-email></p>
          </header>

          <div class="py-4 border-t border-slate-100">
            <div class="max-w-xl">
              <h3 class="font-medium text-slate-900">Consent controls</h3>
              <p class="text-sm text-slate-500 mt-1" data-profile-toggle-help>
                Control storage and processing by data category. Revoking a category starts scoped deletion for that category.
              </p>
            </div>
            <div class="mt-3 space-y-3">
              <div class="flex items-center justify-between">
                <div class="max-w-xl">
                  <h4 class="font-medium text-slate-900">Basic processing</h4>
                  <p class="text-sm text-slate-500 mt-1">Adult saved measurements plus quick/premium adult history. Revoking removes them.</p>
                </div>
                <label class="toggle flex-shrink-0 ml-4" aria-label="Basic processing consent">
                  <input type="checkbox" data-consent-type-toggle="basic_processing" />
                  <span class="toggle__track"></span>
                </label>
              </div>
              <div class="flex items-center justify-between">
                <div class="max-w-xl">
                  <h4 class="font-medium text-slate-900">Sensitive health processing</h4>
                  <p class="text-sm text-slate-500 mt-1">Injury/health premium inputs and saved adult premium analyses. Revoking removes premium history.</p>
                </div>
                <label class="toggle flex-shrink-0 ml-4" aria-label="Sensitive health processing consent">
                  <input type="checkbox" data-consent-type-toggle="sensitive_health_processing" />
                  <span class="toggle__track"></span>
                </label>
              </div>
              <div class="flex items-center justify-between">
                <div class="max-w-xl">
                  <h4 class="font-medium text-slate-900">Child data processing</h4>
                  <p class="text-sm text-slate-500 mt-1">Child profiles, forecasts, and child-linked runs. Revoking removes stored child results immediately (including within 7 days).</p>
                </div>
                <label class="toggle flex-shrink-0 ml-4" aria-label="Child data processing consent">
                  <input type="checkbox" data-consent-type-toggle="child_data_processing" />
                  <span class="toggle__track"></span>
                </label>
              </div>
            </div>
          </div>
          
          <div class="status-area mt-2" data-profile-consent-status></div>

          <div class="py-4 border-t border-slate-100 mt-4" data-account-delete-zone>
            <div class="max-w-xl">
              <h3 class="font-medium text-slate-900">Delete account permanently</h3>
              <p class="text-sm text-slate-500 mt-1">
                Deletes your profile, measurements, recommendations, child-linked analysis data, and account access.
                We retain a minimal pseudonymous billing ledger for legal accounting and chargeback obligations.
              </p>
            </div>
            <div class="mt-3">
              <button type="button" class="btn-pill btn-pill-secondary btn-pill-sm" data-account-delete-open>
                Delete account
              </button>
            </div>
            <div class="status-area mt-3" data-account-delete-status></div>
          </div>

          <div class="py-4 border-t border-slate-100 mt-4" data-data-delete-zone>
            <div class="max-w-xl">
              <h3 class="font-medium text-slate-900">Delete measurements and results</h3>
              <p class="text-sm text-slate-500 mt-1">
                Deletes saved measurements, submissions, recommendations, premium intake inputs, and child-linked forecast history shared with active guardians of the same child.
                Your account, consent settings, and billing records stay unchanged.
              </p>
            </div>
            <div class="mt-3">
              <button type="button" class="btn-pill btn-pill-secondary btn-pill-sm" data-data-delete-open>
                Delete all measurements & results
              </button>
            </div>
            <div class="status-area mt-3" data-data-delete-status></div>
          </div>

          <div class="flex items-center justify-between py-4 border-t border-slate-100 mt-4" data-measurement-system-zone>
            <div class="max-w-xl">
              <h3 class="font-medium text-slate-900">Measurement units</h3>
              <p class="text-sm text-slate-500 mt-1">
                Set your default unit system across Sporty intake and results.
              </p>
            </div>
            <div class="inline-flex rounded-full border border-slate-200 bg-slate-50 p-1" role="group" aria-label="Measurement system">
              <button
                class="btn-pill btn-pill-secondary btn-pill-xs"
                type="button"
                data-measurement-system-option="metric"
              >
                Metric
              </button>
              <button
                class="btn-pill btn-pill-secondary btn-pill-xs"
                type="button"
                data-measurement-system-option="imperial"
              >
                Imperial
              </button>
            </div>
          </div>
          <p class="text-xs text-slate-500 mt-2" data-measurement-system-status hidden></p>

          <div class="flex items-center justify-between py-4 border-t border-slate-100 mt-4">
            <div class="max-w-xl">
              <h3 class="font-medium text-slate-900">Family</h3>
              <p class="text-sm text-slate-500 mt-1">
                Your registered children and linked guardians.
              </p>
            </div>
          </div>

          <div class="mt-2" data-family-zone>
            <div class="rounded-lg border border-slate-100 bg-white px-4 py-3 mb-3" data-parent-sharing-note>
              <div class="badge-subtle mb-2">Parent measurements</div>
              <p class="text-sm text-slate-500">
                Biological parents can optionally share their <span class="font-medium text-slate-700">latest</span> saved measurements with all active guardians of a child.
                This helps co-guardians (including coaches) produce better forecasts.
              </p>
            </div>

            <div class="rounded-lg border border-slate-100 bg-white px-4 py-3 mb-3" data-invite-inbox>
              <div class="flex items-center justify-between">
                <div>
                  <div class="badge-subtle mb-2">Invites</div>
                  <h4 class="m-0 text-slate-900 font-medium">Pending guardian invites</h4>
                </div>
              </div>
              <p class="text-sm text-slate-500 py-2" data-invite-loading hidden>Loading invites…</p>
              <p class="text-sm text-slate-500 py-2" data-invite-empty hidden>No pending invites.</p>
              <ul class="space-y-2" data-invite-list></ul>
            </div>

            <div class="flex items-center justify-between gap-3 py-2">
              <button class="btn-pill btn-pill-secondary btn-pill-sm" type="button" data-family-add-open>
                Add child
              </button>
            </div>

            <form class="rounded-lg border border-slate-100 bg-white px-4 py-3 mt-2" data-family-add-form hidden>
              <div class="grid gap-3 sm:grid-cols-3">
                <label class="field">
                  <span class="field__label">Name</span>
                  <input class="input-field" type="text" name="name" placeholder="Optional" />
                </label>
                <label class="field">
                  <span class="field__label">Birthdate</span>
                  <input class="input-field" type="date" name="birthdate" required />
                </label>
                <label class="field">
                  <span class="field__label">Sex</span>
                  <select class="input-field input-select-pill" name="sex" required>
                    <option value="female">Female</option>
                    <option value="male">Male</option>
                    <option value="other">Other</option>
                    <option value="prefer_not_to_say">Prefer not to say</option>
                  </select>
                </label>
              </div>
              <div class="grid gap-3 sm:grid-cols-2 mt-3">
                <label class="field">
                  <span class="field__label">Your relation</span>
                  <select class="input-field input-select-pill" name="biological_role" required>
                    <option value="unknown">Unknown</option>
                    <option value="mother">Biological mother</option>
                    <option value="father">Biological father</option>
                    <option value="not_biological">Not biological parent</option>
                  </select>
                </label>
              </div>
              <div class="flex items-center justify-end gap-2 mt-3">
                <button class="btn-pill btn-pill-secondary btn-pill-sm" type="button" data-family-add-cancel>
                  Cancel
                </button>
                <button class="btn-pill btn-pill-primary btn-pill-sm" type="submit">
                  Save child
                </button>
              </div>
              <p class="text-sm text-slate-500 mt-2" data-family-add-status hidden></p>
            </form>

            <p class="text-sm text-slate-500 py-2" data-family-loading hidden>Loading family…</p>
            <p class="text-sm text-slate-500 py-2" data-family-empty hidden>No children registered yet.</p>
            <ul class="space-y-4" data-family-list></ul>
          </div>
        </section>
      </section>
    </div>

    <dialog
      class="rounded-xl border border-slate-200 p-0 w-full max-w-lg"
      data-child-analysis-dialog
    >
      <form method="dialog" class="p-5">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h3 class="m-0 text-slate-900 font-semibold">Run a child analysis</h3>
            <p class="text-sm text-slate-500 mt-1">Choose which child you want to run the forecast + premium flow for.</p>
          </div>
          <button class="btn-pill btn-pill-secondary btn-pill-xs" value="cancel" type="submit">Close</button>
        </div>
        <div class="mt-4" data-child-analysis-dialog-body>
          <p class="text-sm text-slate-500" data-child-analysis-dialog-loading hidden>Loading children…</p>
          <p class="text-sm text-slate-500" data-child-analysis-dialog-empty hidden>No children found.</p>
          <ul class="space-y-2" data-child-analysis-dialog-list></ul>
        </div>
      </form>
    </dialog>

    <div class="auth-overlay" data-account-delete-overlay hidden>
      <div class="consent-modal" role="dialog" aria-modal="true" aria-labelledby="account-delete-title">
        <h2 id="account-delete-title">Delete account permanently?</h2>
        <p>
          This signs you out and cannot be undone. Type <strong>DELETE</strong> to confirm. We keep only a minimal
          pseudonymous billing ledger where legally required.
        </p>
        <label class="block mt-3 text-sm text-slate-600" for="account-delete-confirm-input">
          Type DELETE to continue
        </label>
        <input
          id="account-delete-confirm-input"
          type="text"
          class="mt-2 w-full rounded-md border border-slate-200 px-3 py-2 text-sm"
          placeholder="DELETE"
          data-account-delete-confirm-input
        />
        <p class="mt-2 text-xs text-slate-500" data-account-delete-confirm-help>
          Deleted: profile + sport analysis data. Retained: minimal billing ledger.
        </p>
        <div class="consent-modal__actions mt-4 flex gap-3 justify-end">
          <button
            type="button"
            class="btn-pill btn-pill-secondary btn-pill-sm"
            data-account-delete-cancel
          >
            Cancel
          </button>
          <button
            type="button"
            class="btn-pill btn-pill-danger btn-pill-sm btn-pill-disabled"
            data-account-delete-confirm
            aria-disabled="true"
            disabled
          >
            Delete account
          </button>
        </div>
      </div>
    </div>

    <div class="auth-overlay" data-data-delete-overlay hidden>
      <div class="consent-modal" role="dialog" aria-modal="true" aria-labelledby="data-delete-title">
        <h2 id="data-delete-title">Delete all measurements and results?</h2>
        <p>
          This removes your saved analysis history but keeps your account and consent setting.
          Type <strong>DELETE DATA</strong> to confirm.
        </p>
        <label class="block mt-3 text-sm text-slate-600" for="data-delete-confirm-input">
          Type DELETE DATA to continue
        </label>
        <input
          id="data-delete-confirm-input"
          type="text"
          class="mt-2 w-full rounded-md border border-slate-200 px-3 py-2 text-sm"
          placeholder="DELETE DATA"
          data-data-delete-confirm-input
        />
        <p class="mt-2 text-xs text-slate-500" data-data-delete-confirm-help>
          Deleted: measurements + sport-analysis history. Retained: account, consent, billing.
        </p>
        <div class="consent-modal__actions mt-4 flex gap-3 justify-end">
          <button
            type="button"
            class="btn-pill btn-pill-secondary btn-pill-sm"
            data-data-delete-cancel
          >
            Cancel
          </button>
          <button
            type="button"
            class="btn-pill btn-pill-danger btn-pill-sm btn-pill-disabled"
            data-data-delete-confirm
            aria-disabled="true"
            disabled
          >
            Delete data
          </button>
        </div>
      </div>
    </div>
  </main>

  <Fragment slot="scripts">
    <script is:inline src="/assets/js/dashboard.js" defer></script>
    <script is:inline src="/assets/js/checkout.js" defer></script>
  </Fragment>
</BaseLayout>
