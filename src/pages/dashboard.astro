---
import BaseLayout from '../layouts/BaseLayout.astro';

const historyPlaceholders = [
  {
    title: 'Adult premium analysis',
    date: '2025-09-28',
    summary: 'Highlighted trail running, rowing, and climbing with 68% body alignment.',
  },
  {
    title: 'Child forecast — Casey',
    date: '2025-08-12',
    summary: 'Projected 6’1” adult height, strong wingspan, suggested volleyball and swimming.',
  },
];
---
<BaseLayout title="Sporty — Dashboard" description="Review saved analyses, credit balances, and measurement locker." showAuth={true}>
  <main class="dashboard-shell" data-dashboard-root>
    <section class="dashboard-card dashboard-card--full" data-dashboard-signed-out>
      <h1 class="section-title" style="margin:0;">Sign in to view your dashboard</h1>
      <p class="lead-copy">History, credits, and saved measurements live here. Sign in or create an account to continue.</p>
      <div class="btn-row">
        <button class="btn-primary" type="button" data-auth-open data-auth-mode="signin">Log in</button>
        <button class="btn-ghost" type="button" data-auth-open data-auth-mode="signup">Create account</button>
        <a class="btn-ghost" href="/pricing">See pricing</a>
      </div>
    </section>

    <div class="dashboard-layout" data-dashboard-signed-in hidden>
      <aside class="dashboard-sidebar">
        <section class="dashboard-card" data-checkout-zone>
          <h2>Credits</h2>
          <p class="lead-copy">Adult: <span data-credits-adult>—</span></p>
          <p class="lead-copy">Child: <span data-credits-child>—</span></p>
          <p class="credit-status" data-checkout-status hidden></p>
          <div class="button-column">
            <button
              class="btn-primary"
              type="button"
              data-checkout-product="single_adult_analysis"
              data-checkout-credit-type="adult"
              data-checkout-context="adult"
            >
              Buy adult credit
            </button>
            <button
              class="btn-ghost"
              type="button"
              data-checkout-product="single_child_analysis"
              data-checkout-credit-type="child"
              data-checkout-context="child"
            >
              Buy child credit
            </button>
            <a class="btn-ghost" href="/pricing">Pricing overview</a>
            <a class="btn-ghost" href="/intake">Start new analysis</a>
            <a class="btn-ghost" href="/child-intake">Forecast a child</a>
          </div>
        </section>

      <section class="dashboard-card">
        <h2>Measurement locker</h2>
        <p data-measurement-locker-empty>No saved measurements yet. Run an analysis to store your latest inputs.</p>
        <ul class="measurement-list" data-measurement-locker hidden></ul>
      </section>

      <section class="dashboard-card">
        <h2>Shortcuts</h2>
        <ul class="shortcut-list">
          <li><a href="/results">View latest results</a></li>
          <li><a href="/account">Account → Data &amp; Privacy</a></li>
          <li><a href="/pricing">Pricing &amp; credits</a></li>
        </ul>
      </section>
    </aside>

    <section class="dashboard-content">
      <header class="dashboard-header">
        <div>
          <p class="badge">Saved analyses</p>
          <h1 class="section-title">Your history</h1>
          <p class="lead-copy">Track free and premium results, compare progress, and rerun analyses when you’re ready.</p>
        </div>
        <div class="btn-row">
          <a class="btn-primary" href="/intake">New adult analysis</a>
          <a class="btn-ghost" href="/child-intake">New child forecast</a>
        </div>
      </header>

      <div class="history-grid" data-history-grid>
        {historyPlaceholders.map((item) => (
          <article class="history-card" data-history-placeholder>
            <h2>{item.title}</h2>
            <p class="meta">{item.date}</p>
            <p>{item.summary}</p>
            <div class="history-card__actions">
              <button class="btn-primary btn-sm" type="button" disabled>View details (stub)</button>
              <button class="btn-ghost btn-sm" type="button" disabled>Delete</button>
            </div>
          </article>
        ))}
      </div>
    </section>
    </div>
  </main>

  <Fragment slot="head">
    <style is:global>
      .dashboard-shell {
        max-width: min(var(--size-xl), 70rem);
        margin: clamp(2rem, 5vw, 4rem) auto;
        padding: 0 clamp(1.5rem, 4vw, 3rem);
        display: grid;
        gap: clamp(1.5rem, 4vw, 2.5rem);
      }
      .dashboard-layout {
        display: grid;
        grid-template-columns: minmax(260px, 320px) minmax(0, 1fr);
        gap: clamp(1.5rem, 4vw, 2.5rem);
      }
      .dashboard-sidebar {
        display: grid;
        gap: clamp(1.5rem, 3vw, 2.25rem);
        align-content: start;
      }
      .dashboard-card {
        border-radius: 24px;
        border: 1px solid rgba(148, 163, 184, 0.25);
        background: linear-gradient(180deg, rgba(241, 245, 249, 0.55), rgba(255, 255, 255, 0.95));
        padding: clamp(1.5rem, 3vw, 2rem);
        display: grid;
        gap: 0.9rem;
      }
      .dashboard-card h2 {
        margin: 0;
        font-size: 1.1rem;
      }
      .button-column {
        display: grid;
        gap: 0.75rem;
      }
      .button-column .btn-primary[data-loading],
      .button-column .btn-ghost[data-loading] {
        opacity: 0.65;
        pointer-events: none;
      }
      .credit-status {
        margin: 0;
        font-weight: 600;
      }
      .credit-status[data-tone="error"] {
        color: #b91c1c;
      }
      .credit-status[data-tone="warn"] {
        color: #b45309;
      }
      .credit-status[data-tone="info"] {
        color: #0f766e;
      }
      .credit-status[data-tone="success"] {
        color: #0f766e;
      }
      .measurement-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.5rem;
        color: var(--gray-6);
      }
      .shortcut-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.5rem;
      }
      .shortcut-list a {
        font-weight: 600;
      }
      .dashboard-content {
        display: grid;
        gap: clamp(1.5rem, 3vw, 2.25rem);
      }
      .dashboard-header .badge {
        display: inline-block;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        color: var(--brand-7);
      }
      .history-grid {
        display: grid;
        gap: clamp(1.25rem, 3vw, 2rem);
      }
      .history-card {
        border-radius: 24px;
        border: 1px solid rgba(148, 163, 184, 0.25);
        padding: clamp(1.5rem, 3vw, 2rem);
        background: rgba(226, 232, 240, 0.35);
        display: grid;
        gap: 0.75rem;
      }
      .history-card h2 {
        margin: 0;
        font-size: 1.1rem;
      }
      .history-card .meta {
        margin: 0;
        font-size: 0.9rem;
        color: var(--gray-6);
      }
      .history-card__actions {
        display: flex;
        gap: 0.75rem;
        flex-wrap: wrap;
      }
      .dashboard-card--full {
        border-radius: 24px;
        border: 1px solid rgba(148, 163, 184, 0.25);
        background: linear-gradient(180deg, rgba(241, 245, 249, 0.55), rgba(255, 255, 255, 0.95));
        padding: clamp(1.75rem, 3vw, 2.25rem);
      }
    </style>
  </Fragment>

  <Fragment slot="scripts">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" defer></script>
    <script src="/config.js" defer></script>
    <script src="/assets/js/app.js" defer></script>
    <script src="/assets/js/dashboard.js" defer></script>
    <script src="/assets/js/checkout.js" defer></script>
  </Fragment>
</BaseLayout>
