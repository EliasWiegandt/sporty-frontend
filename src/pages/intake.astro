---
import BaseLayout from '../layouts/BaseLayout.astro';
import IntakeApp from '../components/intake/IntakeApp';
import { freeMeasurementFields } from '../data/measurementFields';

const measurementMeta = freeMeasurementFields.map((field) => ({
  id: field.id,
  label: `${field.label} (${field.unit})`,
  unit: field.unit,
  min: field.min,
  max: field.max,
  step: field.step ?? 1,
}));
---
<BaseLayout
  title="Sporty — Quick Adult Intake"
  description="Provide your measurements to get free sport matches tailored to your body."
>
  <main class="mx-auto max-w-5xl space-y-10 pb-32">
    <div data-intake-root>
      <section class="section-shell space-y-8">
        <form
          id="intake-form"
          class="space-y-10"
          data-intake-form
          data-measurements={JSON.stringify(measurementMeta)}
        >
          <IntakeApp client:load mode="free" />

          <div class="space-y-4">
            <div data-status aria-live="polite"></div>
          </div>
        </form>
      </section>
    </div>
  </main>

  <Fragment slot="scripts">
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" defer></script>
    <script is:inline src="/config.js" defer></script>
    <script is:inline src="/assets/js/app.js?v=5" defer></script>
  </Fragment>
</BaseLayout>
