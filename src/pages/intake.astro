---
import BaseLayout from '../layouts/BaseLayout.astro';
import IntakeApp from '../components/intake/IntakeApp';
---
<BaseLayout
  title="Sporty — Quick Adult Intake"
  description="Provide your measurements to get free sport matches tailored to your body."
>
  <main class="mx-auto max-w-5xl space-y-10 pb-32">
    <div data-intake-root>
      <section class="section-shell space-y-8">
        <form
          id="intake-form"
          class="space-y-10"
          data-intake-form
        >
          <IntakeApp client:load mode="free" />

          <div class="space-y-4">
            <div data-status aria-live="polite"></div>
          </div>
        </form>
      </section>
    </div>
  </main>

  <Fragment slot="scripts">
  </Fragment>
</BaseLayout>
