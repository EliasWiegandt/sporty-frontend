---
import BaseLayout from '../layouts/BaseLayout.astro';
import MeasurementField from '../components/forms/MeasurementField.astro';
import NumberStepper from '../components/forms/NumberStepper.astro';
import { measurementFields } from '../data/measurementFields';

const measurementMeta = measurementFields.map((field) => ({
  id: field.id,
  label: `${field.label} (${field.unit})`,
  unit: field.unit,
  min: field.min,
  max: field.max,
  step: field.step ?? 1,
}));
---
<BaseLayout
  title="Sporty — Free Adult Intake"
  description="Provide your measurements to get free sport matches tailored to your body."
>
  <main class="mx-auto max-w-5xl space-y-10 pb-32">
    <section class="section-shell space-y-8">
      <form
        id="intake-form"
        class="space-y-10"
        data-intake-form
        data-measurements={JSON.stringify(measurementMeta)}
      >
        <div class="hs-stepper flex flex-col gap-6" data-hs-stepper='{"mode":"linear"}'>
          <div class="grid gap-3 md:grid-cols-3" data-hs-stepper-nav>
            <button
              type="button"
              class="btn-pill btn-pill-secondary btn-pill-sm flex flex-col items-start gap-1 text-left border border-slate-200 bg-white transition hs-stepper-active:border-2 hs-stepper-active:border-slate-900 hs-stepper-active:shadow-none hs-stepper-completed:bg-teal-100 hs-stepper-completed:text-teal-700"
              data-hs-stepper-nav-item='{"index":1}'
            >
              <span class="font-semibold text-slate-800">Basics</span>
              <span class="type-small text-slate-500">Birthday &amp; sex</span>
            </button>
            <button
              type="button"
              class="btn-pill btn-pill-secondary btn-pill-sm flex flex-col items-start gap-1 text-left border border-slate-200 bg-white transition hs-stepper-active:border-2 hs-stepper-active:border-slate-900 hs-stepper-active:shadow-none hs-stepper-completed:bg-teal-100 hs-stepper-completed:text-teal-700"
              data-hs-stepper-nav-item='{"index":2}'
            >
              <span class="font-semibold text-slate-800">Measurements</span>
              <span class="type-small text-slate-500">Eight required inputs</span>
            </button>
            <button
              type="button"
              class="btn-pill btn-pill-secondary btn-pill-sm flex flex-col items-start gap-1 text-left border border-slate-200 bg-white transition hs-stepper-active:border-2 hs-stepper-active:border-slate-900 hs-stepper-active:shadow-none hs-stepper-completed:bg-teal-100 hs-stepper-completed:text-teal-700"
              data-hs-stepper-nav-item='{"index":3,"isFinal":true}'
            >
              <span class="font-semibold text-slate-800">Past sports</span>
              <span class="type-small text-slate-500">Optional experience</span>
            </button>
          </div>

          <div class="space-y-6" data-hs-stepper-content>
            <div class="card-shell space-y-6" data-hs-stepper-content-item='{"index":1}' id="step-basics">
              <header class="space-y-2">
                <h2 class="type-title text-slate-900">Who are we measuring?</h2>
                <p class="text-slate-600">
                  We use your birthday and sex to place you in the right cohort.
                </p>
              </header>
              <fieldset class="space-y-6">
                <div class="grid gap-6 md:grid-cols-2">
                  <label class="space-y-2" for="birthday">
                    <span class="type-body font-semibold text-slate-800">Birthday</span>
                    <input class="input-field" type="date" name="birthday" id="birthday" required />
                    <span class="text-sm text-slate-500">Used only to infer age brackets.</span>
                  </label>
                  <label class="space-y-2" for="sex">
                    <span class="type-body font-semibold text-slate-800">Sex</span>
                    <div class="hs-combo-box inline-block w-full" data-hs-combo-box='{"isOpenOnFocus":true}'>
                      <input
                        id="sex"
                        name="sex"
                        type="text"
                        autocomplete="off"
                        class="sr-only"
                        required
                        data-hs-combo-box-input
                      />
                      <button
                        type="button"
                        class="input-field flex w-full items-center justify-between"
                        data-hs-combo-box-toggle
                        data-combo-toggle="sex"
                      >
                        <span data-hs-combo-box-deselect-value data-default-label="Select one">Select one</span>
                        <span class="ml-2 text-slate-500">
                          <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z" clip-rule="evenodd" />
                          </svg>
                        </span>
                      </button>
                      <div class="hs-combo-box-panel mt-2 hidden rounded-2xl border border-slate-200 bg-white shadow-lg" data-hs-combo-box-output>
                        <div class="space-y-1" data-hs-combo-box-output-items-wrapper>
                          <button type="button" class="combo-option" data-hs-combo-box-output-item='{"group":{"name":"default","title":"Options"}}'>
                            <span data-hs-combo-box-search-text>Female</span>
                            <span class="hidden" data-hs-combo-box-value>female</span>
                          </button>
                          <button type="button" class="combo-option" data-hs-combo-box-output-item='{"group":{"name":"default","title":"Options"}}'>
                            <span data-hs-combo-box-search-text>Male</span>
                            <span class="hidden" data-hs-combo-box-value>male</span>
                          </button>
                          <button type="button" class="combo-option" data-hs-combo-box-output-item='{"group":{"name":"default","title":"Options"}}'>
                            <span data-hs-combo-box-search-text>Other</span>
                            <span class="hidden" data-hs-combo-box-value>other</span>
                          </button>
                          <button type="button" class="combo-option" data-hs-combo-box-output-item='{"group":{"name":"default","title":"Options"}}'>
                            <span data-hs-combo-box-search-text>Prefer not to say</span>
                            <span class="hidden" data-hs-combo-box-value>prefer_not_to_say</span>
                          </button>
                        </div>
                      </div>
                    </div>
                    <span class="text-sm text-slate-500">Helps line you up with cohort averages.</span>
                  </label>
                </div>
              </fieldset>
            </div>

            <div
              class="card-shell space-y-6"
              data-hs-stepper-content-item='{"index":2}'
              id="step-measurements"
              style="display: none;"
            >
              <header class="space-y-2">
                <h2 class="type-title text-slate-900">Measurements</h2>
                <p class="text-slate-600">
                  Every measurement below is required so we can benchmark you accurately. Keep a flexible tape handy.
                </p>
              </header>
              <fieldset class="grid gap-6 md:grid-cols-2">
                {measurementFields.map((field) => (
                  <MeasurementField {...field} />
                ))}
              </fieldset>
            </div>

            <div
              class="card-shell space-y-6"
              data-hs-stepper-content-item='{"index":3,"isFinal":true}'
              id="step-past-sports"
              style="display: none;"
            >
              <header class="space-y-2">
                <h2 class="type-title text-slate-900">Past sports (optional)</h2>
                <p class="text-slate-600">
                  Share up to five sports you’ve played. Signed-in users blend this into future matches.
                </p>
              </header>
              <section
                class="space-y-4"
                data-past-sports
              >
                <div class="flex flex-wrap items-center justify-between gap-3">
                  <span class="text-sm text-slate-500" data-past-count>0 / 5</span>
                  <button
                    type="button"
                    class="btn-pill btn-pill-secondary btn-pill-sm"
                    data-past-add
                  >
                    Add sport
                  </button>
                </div>
                <p class="text-sm text-slate-500 border border-dashed border-slate-300 rounded-2xl px-4 py-6 text-center" data-past-empty>
                  Add the sports and disciplines you’ve spent time in. These influence both free and premium matches.
                </p>
                <div class="space-y-4" data-past-items></div>
                <template data-past-template>
                  <div class="rounded-3xl border border-slate-200/80 bg-white px-4 py-5 shadow-sm space-y-4" data-item>
                    <label class="space-y-2">
                      <span class="type-body font-semibold text-slate-800">Sport or discipline</span>
                      <div class="relative" data-picker>
                        <input
                          type="text"
                          class="input-field"
                          data-field="sport_label"
                          placeholder="Search sports…"
                          autocomplete="off"
                        />
                        <input type="hidden" data-field="sport_subcategory_id" />
                        <div
                          class="absolute inset-x-0 top-full z-20 mt-2 max-h-60 overflow-y-auto rounded-2xl border border-slate-200 bg-white shadow-lg hidden"
                          data-search-results
                          role="listbox"
                          aria-label="Sport suggestions"
                        ></div>
                      </div>
                    </label>
                <div class="grid gap-4 md:grid-cols-2">
                  <label class="space-y-2 group">
                    <span class="type-body font-semibold text-slate-800">Years played</span>
                    <span class="text-sm text-slate-500">Total active years (subtract longer breaks).</span>
                    <NumberStepper
                      step={0.5}
                      min={0}
                      max={80}
                      inputmode="decimal"
                      wrapperClass="inline-flex w-full max-w-[10rem] items-center overflow-hidden rounded-2xl border border-slate-200 bg-white"
                      inputClass="h-11 w-full px-4 text-right text-lg text-slate-900 focus:outline-none focus:ring-0 bg-white"
                      inputAttrs={{ 'data-field': 'years_played', 'data-allow-empty': 'true' }}
                      incrementAttrs={{ 'aria-label': 'Increase years played', class: 'border-l border-slate-200' }}
                      decrementAttrs={{ 'aria-label': 'Decrease years played', class: 'border-r border-slate-200' }}
                    />
                  </label>
                  <label class="space-y-2">
                    <span class="type-body font-semibold text-slate-800">Starting age</span>
                    <span class="text-sm text-slate-500">How old you were when you first played.</span>
                    <NumberStepper
                      step={1}
                      min={0}
                      max={80}
                      inputmode="numeric"
                      wrapperClass="inline-flex w-full max-w-[10rem] items-center overflow-hidden rounded-2xl border border-slate-200 bg-white"
                      inputClass="h-11 w-full px-4 text-right text-lg text-slate-900 focus:outline-none focus:ring-0 bg-white"
                      inputAttrs={{ 'data-field': 'age_started_years', 'data-allow-empty': 'true' }}
                      incrementAttrs={{ 'aria-label': 'Increase starting age', class: 'border-l border-slate-200' }}
                      decrementAttrs={{ 'aria-label': 'Decrease starting age', class: 'border-r border-slate-200' }}
                    />
                  </label>
                </div>
                    <label class="space-y-2">
                      <span class="type-body font-semibold text-slate-800">Intensity</span>
                      <div class="hs-combo-box inline-block w-full" data-hs-combo-box>
                        <input
                          type="text"
                          class="sr-only"
                          autocomplete="off"
                          data-field="intensity"
                          data-hs-combo-box-input
                        />
                        <button type="button" class="input-field flex w-full items-center justify-between" data-hs-combo-box-toggle data-combo-toggle="intensity">
                          <span data-hs-combo-box-deselect-value data-default-label="Select">Select</span>
                          <span class="ml-2 text-slate-500">
                            <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z" clip-rule="evenodd" />
                            </svg>
                          </span>
                        </button>
                        <div class="hs-combo-box-panel mt-2 hidden rounded-2xl border border-slate-200 bg-white shadow-lg" data-hs-combo-box-output>
                          <div class="space-y-1" data-hs-combo-box-output-items-wrapper>
                            <button type="button" class="combo-option" data-hs-combo-box-output-item='{"group":{"name":"default","title":"Options"}}'>
                              <span data-hs-combo-box-search-text>Casual / recreational</span>
                              <span class="hidden" data-hs-combo-box-value>light</span>
                            </button>
                            <button type="button" class="combo-option" data-hs-combo-box-output-item='{"group":{"name":"default","title":"Options"}}'>
                              <span data-hs-combo-box-search-text>Regular weekly sessions</span>
                              <span class="hidden" data-hs-combo-box-value>moderate</span>
                            </button>
                            <button type="button" class="combo-option" data-hs-combo-box-output-item='{"group":{"name":"default","title":"Options"}}'>
                              <span data-hs-combo-box-search-text>Competitive season</span>
                              <span class="hidden" data-hs-combo-box-value>intense</span>
                            </button>
                            <button type="button" class="combo-option" data-hs-combo-box-output-item='{"group":{"name":"default","title":"Options"}}'>
                              <span data-hs-combo-box-search-text>High performance / elite</span>
                              <span class="hidden" data-hs-combo-box-value>elite</span>
                            </button>
                          </div>
                        </div>
                      </div>
                    </label>
                    <div class="grid gap-4 md:grid-cols-3">
                      <label class="space-y-2">
                        <span class="type-body font-semibold text-slate-800">Enjoyed it?</span>
                        <select class="input-field" data-field="liked">
                          <option value="">Select</option>
                          <option value="yes">Yes</option>
                          <option value="no">No</option>
                        </select>
                      </label>
                      <label class="space-y-2">
                        <span class="type-body font-semibold text-slate-800">Felt natural?</span>
                        <select class="input-field" data-field="had_flair">
                          <option value="">Select</option>
                          <option value="yes">Yes</option>
                          <option value="no">No</option>
                        </select>
                      </label>
                      <label class="space-y-2">
                        <span class="type-body font-semibold text-slate-800">Became good at it?</span>
                        <select class="input-field" data-field="achieved_skill">
                          <option value="">Select</option>
                          <option value="yes">Yes</option>
                          <option value="no">No</option>
                        </select>
                      </label>
                    </div>
                    <div class="flex justify-end">
                      <button type="button" class="btn-pill btn-pill-secondary btn-pill-xs" data-remove>Remove</button>
                    </div>
                  </div>
                </template>
              </section>
            </div>
          </div>

          <div
            class="flex w-full flex-wrap items-center justify-end gap-3"
            data-stepper-actions
          >
            <button
              type="button"
              class="btn-pill btn-pill-secondary btn-pill-sm"
              data-hs-stepper-back-btn
              hidden
              aria-hidden="true"
            >
              Back
            </button>
            <div class="flex items-center gap-3" data-actions>
              <button
                type="button"
                class="btn-pill btn-pill-primary btn-pill-sm"
                data-hs-stepper-next-btn
              >
                Continue
              </button>
              <button
                type="submit"
                class="btn-pill btn-pill-primary"
                data-submit
                hidden
                aria-hidden="true"
              >
                See my matches
              </button>
            </div>
          </div>
        </div>

        <div class="space-y-4">
          <div data-status aria-live="polite"></div>
        </div>
      </form>
    </section>
  </main>

  <Fragment slot="scripts">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" defer></script>
    <script src="/config.js" defer></script>
    <script src="/assets/js/app.js" defer></script>
    <script src="/assets/js/intake.js" defer></script>
  </Fragment>
</BaseLayout>
