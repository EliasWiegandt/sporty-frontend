---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Sporty — Premium analyses" description="Manage and use your premium analysis credits." showAuth={true}>
  <main class="dashboard-shell" data-dashboard-root>
    <!-- Signed-out state: reuse dashboard copy -->
    <section class="dashboard-card dashboard-card--full" data-dashboard-signed-out>
      <div class="max-w-md mx-auto flex flex-col gap-6">
        <iconify-icon icon="mingcute:lock-fill" class="text-5xl text-teal-600 mx-auto"></iconify-icon>
        <div>
          <h1 class="section-title">Sign in to use premium analysis</h1>
          <p class="lead-copy mt-2">Buy and apply credits for adult or child premium runs. Sign in or create an account to continue.</p>
        </div>
        <div class="btn-row">
          <button class="btn-pill btn-pill-primary" type="button" data-auth-open data-auth-mode="signin">Log in</button>
          <button class="btn-pill btn-pill-secondary" type="button" data-auth-open data-auth-mode="signup">Create account</button>
        </div>
        <p class="text-sm text-slate-500 mt-4">
          <a href="/#tiers" class="hover:text-teal-700 underline">View pricing & plans</a>
        </p>
      </div>
    </section>

    <!-- Signed-in state: centered premium credits focus -->
    <section class="dashboard-card dashboard-card--full" data-dashboard-signed-in hidden>
      <div class="max-w-5xl mx-auto flex flex-col gap-8">
        <header class="text-center space-y-2">
          <p class="badge-subtle inline-block">Premium access</p>
          <h1 class="section-title text-3xl">Use your premium analysis credits</h1>
          <p class="lead-copy text-slate-600">Apply a credit for a deep-dive analysis of an adult or forecast + deep-dive analysis of a child.</p>
        </header>

        <div class="grid gap-6 md:grid-cols-2">
          <div class="stat-card p-6 flex flex-col gap-4 text-center h-full">
            <div class="flex items-center justify-center gap-2 text-teal-700 font-semibold text-lg">
              <iconify-icon icon="mingcute:wallet-4-fill" class="text-2xl"></iconify-icon>
              <span>Adult credits</span>
            </div>
            <span class="text-5xl font-bold text-slate-900" data-credits-adult>—</span>
            <p class="text-sm text-slate-500">Apply one credit to run a premium adult analysis.</p>
            <div class="flex flex-col gap-2 mt-auto">
              <button
                class="btn-pill btn-pill-primary w-full justify-center"
                type="button"
                data-premium-run="adult"
                data-premium-run-target="/intake-premium"
              >
                Run analysis
              </button>
              <button
                class="btn-pill btn-pill-secondary w-full justify-center"
                type="button"
                data-checkout-product="single_adult_analysis"
                data-checkout-credit-type="adult"
                data-checkout-context="adult"
              >
                Buy analysis credit
              </button>
            </div>
            <p class="credit-status text-sm text-center" data-checkout-status hidden></p>
          </div>

          <div class="stat-card p-6 flex flex-col gap-4 text-center h-full">
            <div class="flex items-center justify-center gap-2 text-teal-700 font-semibold text-lg">
              <iconify-icon icon="mingcute:wallet-4-fill" class="text-2xl"></iconify-icon>
              <span>Child credits</span>
            </div>
            <span class="text-5xl font-bold text-slate-900" data-credits-child>—</span>
            <p class="text-sm text-slate-500">Use a credit to unlock a child forecast plus premium recommendations.</p>
            <div class="flex flex-col gap-2 mt-auto">
              <button
                class="btn-pill btn-pill-primary w-full justify-center"
                type="button"
                data-premium-run="child"
                data-premium-run-target="/child-premium"
              >
                Run analysis
              </button>
              <button
                class="btn-pill btn-pill-secondary w-full justify-center"
                type="button"
                data-checkout-product="single_child_analysis"
                data-checkout-credit-type="child"
                data-checkout-context="child"
              >
                Buy analysis credit
              </button>
            </div>
          </div>
        </div>

      </div>
    </section>
  </main>

  <Fragment slot="scripts">
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" defer></script>
    <script is:inline src="/config.js" defer></script>
    <script is:inline src="/assets/js/app.js?v=6" defer></script>
    <script is:inline src="/assets/js/dashboard.js" defer></script>
    <script is:inline src="/assets/js/checkout.js" defer></script>
  </Fragment>
</BaseLayout>
