---
import BaseLayout from '../../layouts/BaseLayout.astro';

---
<BaseLayout
  title="Sporty — Your Matches"
  description="Review the sport matches Sporty generated for your body."
>
  <Fragment slot="head">
    <style is:global>
      .result-header {
        max-width: min(var(--size-xl), 70rem);
        margin: clamp(2rem, 4vw, 3.5rem) auto clamp(1rem, 3vw, 2.5rem);
        display: grid;
        gap: 1rem;
        padding: 0 clamp(1.5rem, 5vw, 3rem);
      }
      .result-header h1 {
        margin: 0;
      }
      .cta-inline {
        display: inline-flex;
        gap: 0.75rem;
        align-items: center;
        font-size: 0.95rem;
        color: var(--gray-6);
      }
      .cta-inline a {
        font-weight: 600;
      }
      .results-shell {
        max-width: min(var(--size-xl), 70rem);
        margin: 0 auto clamp(3rem, 6vw, 4.5rem);
        padding: 0 clamp(1.5rem, 5vw, 3rem);
        display: grid;
        gap: clamp(2rem, 4vw, 3rem);
      }
      .results-matches {
        display: grid;
        gap: clamp(1.75rem, 4vw, 2.25rem);
      }
      .results-matches__header {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .results-matches__header h2 {
        margin: 0;
        font-size: 1.4rem;
      }
      .results-matches__grid {
        display: grid;
        gap: clamp(1rem, 3vw, 1.5rem);
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      }
      @media (min-width: 720px) {
        .results-matches__grid {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      @media (min-width: 1040px) {
        .results-matches__grid {
          grid-template-columns: repeat(3, minmax(0, 1fr));
        }
      }
      .results-impact {
        display: grid;
        gap: 1rem;
        padding: clamp(1.5rem, 3vw, 2rem);
        border-radius: 24px;
        border: 1px solid rgba(148, 163, 184, 0.25);
        background: rgba(241, 245, 249, 0.6);
      }
      .results-impact__header h2 {
        margin: 0;
        font-size: 1.4rem;
      }
      .results-impact__header p {
        margin: 0.15rem 0 0;
        color: var(--gray-6);
        font-size: 0.95rem;
      }
      .impact-bar {
        display: flex;
        border-radius: 999px;
        overflow: hidden;
        border: 1px solid rgba(148, 163, 184, 0.4);
        height: 18px;
      }
      .impact-bar__segment {
        position: relative;
        flex: 0 0 auto;
        height: 100%;
      }
      .impact-bar__segment::after {
        content: attr(data-label);
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        font-size: 0.7rem;
        font-weight: 600;
        color: rgba(255, 255, 255, 0.9);
        mix-blend-mode: luminosity;
        pointer-events: none;
      }
      .results-impact__legend {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        padding: 0;
        margin: 0;
        list-style: none;
      }
      .results-impact__legend li {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.9rem;
      }
      .results-impact__legend span {
        width: 12px;
        height: 12px;
        border-radius: 999px;
        display: inline-block;
      }
      .match-card {
        width: 100%;
        border-radius: 20px;
        border: 1px solid rgba(148, 163, 184, 0.25);
        background: linear-gradient(180deg, rgba(241, 245, 249, 0.55), rgba(255, 255, 255, 0.95));
        box-shadow: 0 28px 50px -38px rgba(15, 23, 42, 0.5);
        display: grid;
        gap: clamp(1rem, 2.2vw, 1.35rem);
        padding: clamp(1.15rem, 2.4vw, 1.75rem);
      }
      .match-card__header {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }
      .match-card__rank {
        width: 34px;
        height: 34px;
        border-radius: 999px;
        background: rgba(15, 118, 110, 0.2);
        color: var(--teal-7);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
      }
      .match-card__header h3 {
        margin: 0;
        font-size: 1.1rem;
      }
      .match-card__subtitle {
        margin: 0.15rem 0 0;
        font-size: 0.9rem;
        color: var(--gray-6);
      }
      .match-card__score {
        margin-left: auto;
        font-weight: 700;
        font-size: 1.15rem;
        color: var(--teal-7);
      }
      .match-card__media {
        position: relative;
        width: 100%;
        display: grid;
        place-items: center;
      }
      .match-card__image {
        width: 100%;
        height: auto;
        display: block;
        border-radius: 14px;
        box-shadow: none;
        background: transparent;
      }
      .match-card__media--empty {
        border-style: dashed;
        border-color: rgba(148, 163, 184, 0.35);
        background: rgba(226, 232, 240, 0.35);
        padding: clamp(1.25rem, 2vw, 1.6rem);
      }
      .match-card__placeholder {
        font-size: 0.9rem;
        color: rgba(71, 85, 105, 0.85);
        text-align: center;
      }
      .match-card__summary {
        margin: 0;
        color: var(--gray-12);
        font-size: 0.95rem;
      }
      .match-card__list {
        margin: 0;
        padding-left: 1rem;
        color: var(--gray-6);
        display: grid;
        gap: 0.45rem;
        font-size: 0.9rem;
      }
      .results-highlights {
        display: grid;
        gap: 0.9rem;
      }
      .results-highlights h2 {
        margin: 0;
        font-size: 1.35rem;
      }
      .results-highlights__list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.75rem;
      }
      .results-highlights__item {
        display: flex;
        gap: 0.6rem;
        align-items: flex-start;
        background: rgba(14, 116, 144, 0.08);
        border-radius: 16px;
        border: 1px solid rgba(14, 116, 144, 0.2);
        padding: 0.9rem 1rem;
        font-size: 0.95rem;
        color: var(--gray-12);
      }
      .results-highlights__item span:first-child {
        font-weight: 700;
        color: var(--teal-7);
      }
      .results-metrics {
        display: grid;
        gap: clamp(1.25rem, 3vw, 1.75rem);
      }
      @media (min-width: 720px) {
        .results-metrics {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
      }
      .results-metrics__table {
        border-radius: 20px;
        border: 1px solid rgba(148, 163, 184, 0.22);
        background: var(--gray-0);
        box-shadow: 0 18px 36px -32px rgba(15, 23, 42, 0.4);
        overflow: hidden;
      }
      .results-metrics__table table {
        width: 100%;
        border-collapse: collapse;
      }
      .results-metrics__table th,
      .results-metrics__table td {
        padding: 0.9rem 1.1rem;
        border-bottom: 1px solid rgba(148, 163, 184, 0.18);
        text-align: left;
        font-size: 0.95rem;
      }
      .results-metrics__table tr:last-child th,
      .results-metrics__table tr:last-child td {
        border-bottom: none;
      }
      .results-metrics__table caption {
        padding: 1rem 1.1rem 0;
        font-weight: 600;
        text-align: left;
      }
      .empty-state {
        max-width: 560px;
        margin: 0 auto;
        padding: 2rem;
        text-align: center;
        background: rgba(148, 163, 184, 0.12);
        border-radius: 20px;
        border: 1px dashed rgba(148, 163, 184, 0.3);
      }
      .empty-state h2 {
        margin-top: 0;
      }
    </style>
  </Fragment>

  <header class="result-header">
    <h1 class="section-title">Your sport matches</h1>
    <p class="lead-copy">Here’s how your body lines up with pro-informed sport profiles. Each card shows why the sport fits you today and what to explore next.</p>
    <p class="cta-inline" data-results-message>Sign in to automatically store each run and revisit them anytime.</p>
    <div class="history-picker" data-history-picker hidden>
      <label>
        <span>Saved runs</span>
        <select data-history-select></select>
      </label>
      <button class="btn-ghost btn-sm" type="button" data-history-refresh>Refresh</button>
    </div>
  </header>

  <main class="results-shell">
    <section class="results-impact" data-impact-summary hidden>
      <div class="results-impact__header">
        <h2>What shaped this match</h2>
        <p>How each signal contributed to your overall score.</p>
      </div>
      <div class="impact-bar" data-impact-bar></div>
      <ul class="results-impact__legend" data-impact-legend></ul>
    </section>

    <section class="results-matches" data-results-matches hidden>
      <div class="results-matches__header">
        <h2>Top matches</h2>
      </div>
      <div class="results-matches__grid" data-match-grid></div>
    </section>

    <section class="results-highlights" data-results-highlights hidden>
      <h2>Why this fit stands out</h2>
      <ul class="results-highlights__list" data-highlights-list></ul>
    </section>

    <section class="results-metrics" data-results-metrics hidden>
      <div class="results-metrics__table" data-components-table></div>
      <div class="results-metrics__table" data-measurements-table></div>
    </section>

    <div class="empty-state" data-empty-state hidden>
      <h2>No matches yet</h2>
      <p>We couldn’t find any stored results. Run a new recommendation and we’ll populate this page automatically.</p>
      <div class="btn-row justify-center">
        <a class="btn-primary" href="/intake">Start a new match</a>
      </div>
    </div>
  </main>

  <section class="section-shell section-narrow" id="whats-next">
    <h2 class="section-title">Next steps</h2>
    <div class="grid-cards">
      <article class="card-shell">
        <h3 class="card-title">Share with a coach or friend</h3>
        <p class="card-copy">Show them how your body stacks up and discuss drills or clubs to explore.</p>
      </article>
      <article class="card-shell">
        <h3 class="card-title">Track progress</h3>
        <p class="card-copy">Jot down how the suggested sports feel. Once credits launch, revisit your <a href="/dashboard">dashboard</a> to compare saved runs.</p>
      </article>
      <article class="card-shell">
        <h3 class="card-title">Expand the analysis</h3>
        <p class="card-copy">Upgrade for deeper adult insights and child forecasts as soon as credits launch. Check <a href="/pricing">pricing</a> for details.</p>
      </article>
    </div>
  </section>

  <footer class="footer">
    <div class="footer-inner">
      <div>
        <strong>Something off?</strong>
        <p class="lead-copy">Email hello@sporty.test with feedback. Every suggestion helps us fine-tune the matching engine.</p>
      </div>
      <nav class="footer-nav">
        <a href="/intake">Try again</a>
        <a href="#whats-next">Next steps</a>
        <a href="/">Home</a>
        <a href="/pricing">Pricing</a>
      </nav>
      <small>© <span id="year">2025</span> Sporty</small>
    </div>
  </footer>

  <Fragment slot="scripts">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" defer></script>
    <script src="/config.js" defer></script>
    <script src="/assets/js/app.js" defer></script>
    <script src="/assets/js/results.js" defer></script>
    <script>
      const yearEl = document.getElementById('year');
      if (yearEl) {
        yearEl.textContent = String(new Date().getFullYear());
      }
    </script>
  </Fragment>
</BaseLayout>
