---
import BaseLayout from '../../layouts/BaseLayout.astro';

---
<BaseLayout
  title="Sporty — Your Matches"
  description="Based on your latest intake, see the top sport matches and why they fit."
>
  <main class="results-shell">
    <header class="result-header anchored">
      <h1 class="section-title">Your Top Matches</h1>
      <p class="cta-inline">Based on your body biomechanics and past experience.</p>
    </header>

    <section class="results-container" data-results-container>
      <!-- Matches will be injected here -->
    </section>

    <div class="empty-state" data-empty-state hidden>
      <h2>No matches found</h2>
      <p>We couldn’t generate a match based on your inputs. Please try adjusting your intake data.</p>
      <div class="btn-row justify-center">
        <a class="btn-primary" href="/intake">Start a new match</a>
      </div>
    </div>
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <nav class="footer-nav">
        <a href="/intake">Try again</a>
        <a href="/">Home</a>
      </nav>
      <small>© <span id="year">2025</span> Sporty</small>
    </div>
  </footer>

  <Fragment slot="scripts">
    <script is:inline src="/config.js" defer></script>
    <script is:inline src="/assets/js/results.js" defer></script>
    <script>
      const yearEl = document.getElementById('year');
      if (yearEl) {
        yearEl.textContent = String(new Date().getFullYear());
      }
    </script>
  </Fragment>
  </Fragment>
</BaseLayout>


