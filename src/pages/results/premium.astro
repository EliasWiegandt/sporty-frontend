---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Sporty — Premium Analysis"
  description="Detailed premium analysis with component breakdowns, alignment insights, and recommended next steps."
>
  
  <main class="results-shell" data-premium-root>
    <header class="result-header anchored" data-premium-hero>
      <h1 class="section-title">Your Premium Matches</h1>
      <p class="cta-inline" data-reason>Based on your measurements and premium inputs.</p>
    </header>

    <div class="results-container" data-results-container></div>

    <div class="empty-state" data-empty-state hidden>
      <h2>No premium analysis loaded</h2>
      <p>Run a premium analysis with an adult credit to see detailed insights here.</p>
      <div class="btn-row justify-center">
        <a class="btn-primary" href="/intake">Start a quick analysis</a>
        <a class="btn-secondary" href="/intake-premium">Run a premium analysis</a>
      </div>
    </div>
  </main>

  <Fragment slot="scripts">
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" defer></script>
    <script is:inline src="/config.js" defer></script>
    <script is:inline src="/assets/js/app.js?v=4" defer></script>
    <script is:inline src="/assets/js/results-card-alignment.js" defer></script>
    <script is:inline src="/assets/js/results-premium.js" defer></script>
  </Fragment>
</BaseLayout>
