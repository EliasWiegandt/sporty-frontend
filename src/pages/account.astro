---
import BaseLayout from '../layouts/BaseLayout.astro';

---
<BaseLayout
  title="Sporty — Account & Data Privacy"
  description="Manage your Sporty account, control consent, and review saved analyses."
>
  <main class="section-shell section-narrow account-shell" data-profile-root>
    <section class="card-shell" data-profile-signed-out hidden>
      <h1 class="section-title" style="margin-top:0;">Account</h1>
      <p class="lead-copy">Sign in to review saved measurements, manage data-retention consent, and monitor analysis history.</p>
      <div class="btn-row">
        <button class="btn-primary" type="button" data-auth-open>Log in</button>
        <button class="btn-ghost" type="button" data-signup-open>Create account</button>
      </div>
    </section>

    <section class="card-shell" data-profile-signed-in hidden>
      <header class="profile-header">
        <div>
          <h1 class="section-title" style="margin:0;">Account overview</h1>
          <p class="lead-copy" data-profile-email></p>
        </div>
        <button class="btn-ghost" type="button" data-auth-signout>Log out</button>
      </header>

      <div class="profile-toggle-row">
        <div>
          <h2 class="section-subtitle" style="margin:0;">Store my measurements &amp; free results</h2>
          <p class="profile-help" data-profile-toggle-help>
            Enable this if you want Sporty to remember your free matches. You can turn it off anytime.
          </p>
        </div>
        <label class="toggle" aria-label="Data retention consent">
          <input type="checkbox" data-consent-toggle />
          <span class="toggle__track"></span>
        </label>
      </div>

      <div class="profile-status" data-profile-consent-status></div>

      <section class="account-links">
        <h2 class="section-subtitle">Need something else?</h2>
        <ul>
          <li><a href="/dashboard">View dashboard &amp; history</a></li>
          <li><a href="/pricing">Review pricing &amp; credits</a></li>
          <li><a href="/privacy">Read the privacy policy</a></li>
        </ul>
      </section>
    </section>
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <div>
        <strong>Need support?</strong>
        <p class="lead-copy">Email hello@sporty.test and we will help with account changes or data requests.</p>
      </div>
      <small>© <span id="year">2025</span> Sporty</small>
    </div>
  </footer>

  <Fragment slot="head">
    <style>
      .account-shell {
        max-width: 820px;
        margin: clamp(2rem, 5vw, 4rem) auto;
        padding: 0 clamp(1.5rem, 4vw, 3rem);
      }
      .account-links ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 0.5rem;
      }
      .account-links a {
        font-weight: 600;
      }
    </style>
  </Fragment>

  <Fragment slot="scripts">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" defer></script>
    <script src="/config.js" defer></script>
    <script src="/assets/js/app.js" defer></script>
    <script src="/assets/js/account.js" defer></script>
    <script>
      const yearEl = document.getElementById('year');
    if (yearEl) {
      yearEl.textContent = String(new Date().getFullYear());
    }
    </script>
  </Fragment>
</BaseLayout>
