---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Sporty — Child Premium Matches"
  description="Premium sport matches based on the projected adult body for this child."
>
  <main class="section-shell grid gap-4">
    <div class="grid gap-2 rounded-[18px] border border-dashed border-[rgba(148,163,184,0.35)] p-[clamp(1.6rem,3vw,2.2rem)] text-center text-[var(--gray-6)]">
      <h1 class="section-title" style="margin:0;">Redirecting…</h1>
      <p class="lead-copy">Child results now live on a single page with tabs.</p>
      <div class="btn-row justify-center">
        <a class="btn-primary" href="/child-results?tab=matches">Continue</a>
      </div>
    </div>
  </main>

  <Fragment slot="scripts">
    <script is:inline defer>
      (function () {
        const params = new URLSearchParams(window.location.search || '');
        const id = params.get('id');
        try {
          sessionStorage.setItem('sporty:childResultsTab', 'matches');
        } catch (_) {}
        const nextUrl = id
          ? `/child-results?id=${encodeURIComponent(id)}&tab=matches`
          : '/child-results?tab=matches';
        const link = document.querySelector('a.btn-primary');
        if (link) {
          link.setAttribute('href', nextUrl);
        }
        window.location.replace(nextUrl);
      })();
    </script>
  </Fragment>
</BaseLayout>
