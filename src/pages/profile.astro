---
import BaseLayout from '../layouts/BaseLayout.astro';

---
<BaseLayout
  title="Sporty — Profile & Consents"
  description="Manage your Sporty profile, review saved consents, and control data retention."
>
  <main class="section section--narrow" data-profile-root>
    <section class="card" data-profile-signed-out hidden>
      <h1 class="section__title" style="margin-top:0;">Your profile</h1>
      <p class="lead-copy">Sign in to view saved measurements, manage data-retention consent, and control future analyses.</p>
      <div class="button-row">
        <button class="button" type="button" data-auth-open>Log in</button>
        <button class="button--ghost" type="button" data-signup-open>Create account</button>
      </div>
    </section>

    <section class="card" data-profile-signed-in hidden>
      <header class="profile-header">
        <div>
          <h1 class="section__title" style="margin:0;">Account overview</h1>
          <p class="lead-copy" data-profile-email></p>
        </div>
        <button class="button--ghost" type="button" data-auth-signout>Log out</button>
      </header>

      <div class="profile-toggle-row">
        <div>
          <h2 class="section__subtitle" style="margin:0;">Store my measurements &amp; free results</h2>
          <p class="profile-help" data-profile-toggle-help>
            Enable this if you want Sporty to remember your free matches. You can turn it off anytime.
          </p>
        </div>
        <label class="toggle" aria-label="Data retention consent">
          <input type="checkbox" data-consent-toggle />
          <span class="toggle__track"></span>
        </label>
      </div>

      <div class="profile-status" data-profile-consent-status></div>
    </section>
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <div>
        <strong>Need support?</strong>
        <p class="lead-copy">Email hello@sporty.test and we will help with account changes or data requests.</p>
      </div>
      <small>© <span id="year">2025</span> Sporty</small>
    </div>
  </footer>

  <Fragment slot="scripts">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" defer></script>
    <script src="/config.js" defer></script>
    <script src="/assets/js/app.js" defer></script>
    <script src="/assets/js/profile.js" defer></script>
    <script>
      const yearEl = document.getElementById('year');
    if (yearEl) {
      yearEl.textContent = String(new Date().getFullYear());
    }
    </script>
  </Fragment>
</BaseLayout>
