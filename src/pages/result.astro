---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Sporty — Results" showHeader={false} showAuth={false}>
  <main style="max-width:720px; margin:2rem auto; padding:0 1rem;">
    <nav style="margin-bottom:1rem;">
      <a href="/">← Home</a>
      &nbsp;·&nbsp;
      <a href="/intake">Fill form again</a>
    </nav>

    <h1>Your Result</h1>
    <div id="content"></div>
  </main>

  <Fragment slot="head">
    <style>
      body {
        background: #f9fafb;
      }
      main nav a {
        color: var(--color-accent);
      }
      .card {
        border: 1px solid #e5e7eb;
        padding: 1rem;
        border-radius: 0.5rem;
        background: #fff;
      }
      .help {
        color: #666;
        font-size: 0.95rem;
      }
      pre {
        background: #f6f8fa;
        padding: 1rem;
        border-radius: 0.5rem;
        overflow: auto;
      }
    </style>
    <meta name="robots" content="noindex" />
  </Fragment>

    <Fragment slot="scripts">
    <script>
      const container = document.getElementById('content');
      if (!container) {
        console.warn('[Sporty] result container missing');
      } else {
        const raw = sessionStorage.getItem('sporty:lastResult');

        if (!raw) {
          container.innerHTML = '<p class="help">No result found. Please submit the form first.</p>' +
            '<p><a href="/intake">Go to intake</a></p>';
        } else {
          let data;
          try {
            data = JSON.parse(raw);
          } catch (err) {
            console.error(err);
            data = { raw };
          }

          if (data && (data.suggested_sport || data.reason || data.ranking !== undefined)) {
            const ranking = data.ranking !== undefined ? `<p class="help">Ranking: ${data.ranking}</p>` : '';
            container.innerHTML = `
              <div class="card">
                <h2 style="margin-top:0">${data.suggested_sport || 'Suggested sport'}</h2>
                <p>${data.reason || ''}</p>
                ${ranking}
              </div>
              <h3>Details</h3>
              <pre>${JSON.stringify(data, null, 2)}</pre>
            `;
          } else {
            container.innerHTML = `<pre>${JSON.stringify(data, null, 2)}</pre>`;
          }
        }
      }
    </script>
  </Fragment>

</BaseLayout>
