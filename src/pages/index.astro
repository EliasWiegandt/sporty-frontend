---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Badge, Button, Grid, Ribbon, Stepper, Accordion } from 'webcoreui/astro';

const valuePillars = [
  {
    title: 'Biomechanics-first',
    copy:
      'Our optimal body library blends athlete cohorts, parent-child deltas, and expert heuristics so every recommendation starts with anthropology-grade data.',
    icon: '🧬',
  },
  {
    title: 'Consent + control',
    copy:
      'Unlimited free runs stay ephemeral until you opt in. Supabase-powered consent, exports, and deletion live in the account center when you decide to save.',
    icon: '🛡️',
  },
  {
    title: 'Premium clarity',
    copy:
      'Apply a $5 credit to surface component impact bars, alignment summaries, and actionable training next steps tuned to your goals and constraints.',
    icon: '📊',
  },
  {
    title: 'Built on lived sport',
    copy:
      'Past-sport history, intensity, and flair flags feed our recommendation moat so Sporty keeps learning from real bodies, not generic templates.',
    icon: '🏅',
  },
];

const howSteps = [
  {
    title: 'Measure',
    subtitle: 'Capture the essentials',
    description:
      'Enter birthday, sex, height, weight, and the full measurement set (arm span, inseam, shoulder, hip, hand, foot) with guided ranges and tips.',
  },
  {
    title: 'Layer context',
    subtitle: 'Add the signals that matter',
    description:
      'When you apply a premium credit, blend in goals, preferences, injuries, past sports, and qualitative performance factors for richer alignment.',
  },
  {
    title: 'Analyze',
    subtitle: 'See how your body fits',
    description:
      'Sporty maps your data to curated optimal bodies, returning component impact charts, percentile comparisons, and athlete analogues you can study.',
  },
  {
    title: 'Act + revisit',
    subtitle: 'Save, compare, and share',
    description:
      'Saved runs live in your dashboard alongside credit balances. Guardians can swap between child profiles and rerun analyses as measurements evolve.',
  },
];

const testimonials = [
  {
    quote:
      '“Premium adult analysis gave me the component breakdown I needed. Seeing shoulder width vs. optimal ranges explained why certain drills click.”',
    name: 'Morgan, 32 · Premium member',
  },
  {
    quote:
      '“The guardian flow let us forecast our daughter, apply a credit, and compare sport matches aligned to her projected build—game changer.”',
    name: 'Elena, 39 · Guardian',
  },
];

const offerings = [
  {
    ribbon: 'Included',
    title: 'Free Adult Match',
    price: '$0',
    summary: 'Unlimited biomechanics-backed matches any time you want another perspective.',
    features: [
      'Run the full measurement set with instant sport suggestions.',
      'Review component summaries and athlete analogues for each sport.',
      'Stay anonymous until you opt in to save results.',
    ],
    cta: {
      href: '/intake',
      label: 'Start free match',
      theme: 'primary',
    },
  },
  {
    ribbon: '$5 credit',
    title: 'Premium Adult Analysis',
    price: '$5',
    summary: 'Apply a credit to unlock qualitative inputs and deeper insights.',
    features: [
      'Blend goals, preferences, injuries, past sports, and performance factors.',
      'See component impact bars, alignment scores, and recommended focus areas.',
      'Store runs in your dashboard with share-ready summaries.',
    ],
    cta: {
      href: '/intake?premium=true',
      label: 'Use an adult credit',
      theme: 'secondary',
    },
    secondaryCta: {
      href: '/pricing',
      label: 'View pricing',
      theme: 'outline',
    },
  },
  {
    ribbon: '$5 credit',
    title: 'Child Analysis Package',
    price: '$5',
    summary: 'Forecast and refine a child’s sport path with guardian consent.',
    features: [
      'Project future body metrics using child + parent measurements.',
      'Apply preferences, goals, injuries, and past sports to unlock matches.',
      'Store guardian-backed runs and track credits per child.',
    ],
    cta: {
      href: '/child-intake',
      label: 'Start child analysis',
      theme: 'secondary',
    },
    secondaryCta: {
      href: '/pricing#child',
      label: 'How credits work',
      theme: 'outline',
    },
  },
];

const sampleHighlights = [
  {
    key: 'landing.sample_results.tile_matches',
    alt: 'Square illustration of three sport recommendation cards fanned across a desk.',
    title: 'Sport matches with narrative context',
    copy:
      'Each card surfaces body fit, comparable athletes, and the qualitative cues we considered so you can explain the recommendation to a coach or parent.',
  },
  {
    key: 'landing.sample_results.tile_metrics',
    alt: 'Square illustration of a component impact chart comparing measurements to optimal ranges.',
    title: 'Component impact bar + percentiles',
    copy:
      'See the measurements driving your fit, with percentile bands and suggested training levers to move closer to the optimal window.',
  },
  {
    key: 'landing.sample_results.tile_next_steps',
    alt: 'Square illustration of a clipboard checklist with training next steps.',
    title: 'Actionable next steps',
    copy:
      'Premium runs include drills, local leagues, and follow-up prompts so you always know what to try next.',
  },
];

const faqItems = [
  {
    title: 'Are free adult matches really unlimited?',
    content:
      '<p>Yes. You can run the biomechanics-based quick match as often as you like. Runs stay anonymous until you opt in to save them to your dashboard.</p>',
  },
  {
    title: 'How do premium credits work?',
    content:
      '<p>Premium adult analyses and child packages each cost a single $5 credit. Purchase credits through Stripe Checkout from Pricing or the dashboard, then apply them during intake.</p>',
  },
  {
    title: 'What makes the premium analysis different?',
    content:
      '<p>Credits unlock inputs for goals, preferences, injuries, past sports, and performance factors. The results add component impact bars, alignment summaries, and tailored recommendations.</p>',
  },
  {
    title: 'How does the child analysis package work?',
    content:
      '<p>Guardians measure the child, optionally add parent measurements, then apply a child credit to blend preferences, goals, injuries, and past sports into sport matches.</p><p>Child analyses are only stored when guardians consent, and you can revoke or export data anytime.</p>',
  },
  {
    title: 'Can I control what data you store?',
    content:
      '<p>Absolutely. Consent is required before we store measurements, preferences, injuries, or child data. You can revoke consent, delete runs, or export data under Account → Data & Privacy.</p>',
  },
];

const stepperItems = howSteps.map((step) => ({
  title: step.title,
  subTitle: step.subtitle,
}));
---
<BaseLayout
  title="Sporty — Discover sports that fit your body"
  description="Unlimited free adult matches, $5 premium credits, and guardian-backed child analyses built on biomechanics."
>
  <main>
    <section class="section-shell hero-shell" id="hero">
      <div class="hero__content">
        <Badge theme="info" rounded>
          Credits + guardian flows are live
        </Badge>
        <h1 class="hero-headline">Find the sports you, and your child, are wired for</h1>
        <p class="hero-copy">
        Free analysis based only on bodymeasurements for adults. 
        Premium adult analysis that take goals, preferences, injuries (both healing them and avoiding them) and performance factors into account. 
        Premium analysis to forecast child development match the child to the best sports.
        </p>
        <div class="hero__actions">
          <Button href="/intake" theme="primary">Free adult analysis</Button>
          <Button href="/intake?premium=true" theme="outline">Premium adult analysis</Button>
          <Button href="/child-intake" theme="secondary">Premium child forecast and analysis</Button>
        </div>
      </div>
      <figure class="hero-visual" aria-label="Watercolor illustration highlighting a multi-sport training scene.">
        <img
          data-image-key="landing.hero.banner"
          alt="Watercolor illustration blending basketball, swimming, and running training moments in a single panoramic scene."
          loading="lazy"
        />
      </figure>
    </section>

    <section class="section-shell section--accent" id="pillars" aria-labelledby="pillars-heading">
      <h2 class="section-title" id="pillars-heading">Why Sporty leads the match</h2>
      <Grid gap="lg" column={{ default: 1, md: 2, lg: 4 }}>
        {valuePillars.map((pillar) => (
          <article class="pillar-card">
            <span class="pill-icon" aria-hidden="true">{pillar.icon}</span>
            <h3>{pillar.title}</h3>
            <p>{pillar.copy}</p>
          </article>
        ))}
      </Grid>
    </section>

    <section class="section-shell" id="how-it-works">
      <h2 class="section-title">How Sporty works</h2>
      <Grid gap="xl" column={{ default: 1, md: 2 }} className="how-shell">
        <div class="card-shell stepper-card">
          <h3>End-to-end in four steps</h3>
          <Stepper items={stepperItems} vertical />
        </div>
        <Grid gap="md">
          {howSteps.map((step) => (
            <article class="card-shell how-detail">
              <h3 class="card-title">{step.title}</h3>
              <span class="step-subtitle">{step.subtitle}</span>
              <p class="card-copy">{step.description}</p>
            </article>
          ))}
        </Grid>
      </Grid>
    </section>

    <section class="section-shell testimonial-strip" aria-labelledby="testimonial-heading">
      <h2 class="section-title" id="testimonial-heading">People are already feeling the fit</h2>
      <div class="testimonial-strip__inner">
        {testimonials.map((item) => (
          <figure class="testimonial-card">
            <blockquote>{item.quote}</blockquote>
            <figcaption>{item.name}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="section-shell" id="tiers">
      <h2 class="section-title">Pick the depth you need</h2>
      <p class="lead-copy">Start for free, then reach for adult or child credits when you want premium insights.</p>
      <Grid gap="lg" column={{ default: 1, md: 3 }}>
        {offerings.map((plan) => (
          <article class="card-shell plan-card">
            <div class="plan-card__ribbon">
              <Ribbon theme="info">{plan.ribbon}</Ribbon>
            </div>
            <h3 class="card-title">{plan.title}</h3>
            <p class="plan-price">{plan.price}</p>
            <p class="card-copy">{plan.summary}</p>
            <ul class="feature-list card-copy">
              {plan.features.map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
            <div class="btn-row">
              <Button href={plan.cta.href} theme={plan.cta.theme}>{plan.cta.label}</Button>
              {plan.secondaryCta && (
                <Button href={plan.secondaryCta.href} theme={plan.secondaryCta.theme}>
                  {plan.secondaryCta.label}
                </Button>
              )}
            </div>
          </article>
        ))}
      </Grid>
    </section>

    <section class="section-shell" id="sample-results">
      <h2 class="section-title">What premium-ready results look like</h2>
      <Grid gap="lg" column={{ default: 1, md: 3 }}>
        {sampleHighlights.map((highlight) => (
          <article class="card-shell sample-card">
            <h3 class="card-title">{highlight.title}</h3>
            <figure class="image-tile">
              <img data-image-key={highlight.key} alt={highlight.alt} loading="lazy" />
            </figure>
            <p class="card-copy">{highlight.copy}</p>
          </article>
        ))}
      </Grid>
    </section>

    <section class="section-shell section-narrow" id="why">
      <h2 class="section-title">Why body fit matters</h2>
      <p class="lead-copy">When your build aligns with a sport’s demands, skill work sticks faster and training feels better. Sporty ties anthropometric data to lived experience so you can invest reps where your body thrives.</p>
      <blockquote class="testimonial" aria-label="Founders quote">
        “Sporty demystifies how bodies, preferences, and performance factors interact. Whether you’re exploring sport for yourself or guiding a child, we highlight the activities that honour your strengths.”
        <footer>— Sporty Founders</footer>
      </blockquote>
    </section>

    <section class="section-shell" id="faq">
      <h2 class="section-title">Questions, answered</h2>
      <Accordion items={faqItems} />
    </section>
  </main>

  <div class="sticky-cta" data-sticky-cta hidden>
    <div class="sticky-cta__inner">
      <span class="sticky-cta__copy">Ready? Run your next free match.</span>
      <Button href="/intake" theme="primary">Start now</Button>
    </div>
  </div>

  <footer class="footer">
    <div class="footer-inner">
      <div>
        <strong>Sporty</strong>
        <p class="lead-copy">Helping every body find their sport. Unlimited free adult matches, $5 premium credits, and guardian-backed child insights.</p>
      </div>
      <nav class="footer-nav" aria-label="Footer">
        <a href="/intake">Start free</a>
        <a href="/pricing">Pricing</a>
        <a href="#faq">FAQ</a>
        <a href="/privacy">Privacy (draft)</a>
        <a href="/terms">Terms (draft)</a>
        <a href="mailto:hello@sporty.test">Contact</a>
      </nav>
      <small>© <span id="year">2025</span> Sporty. All rights reserved.</small>
    </div>
  </footer>

  <Fragment slot="scripts">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" defer></script>
    <script src="/config.js" defer></script>
    <script src="/assets/js/app.js" defer></script>
    <script src="/assets/js/landing.js" defer></script>
    <script>
      const yearEl = document.getElementById('year');
      if (yearEl) {
        yearEl.textContent = String(new Date().getFullYear());
      }
    </script>
  </Fragment>
</BaseLayout>
