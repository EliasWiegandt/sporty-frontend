---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  valuePillars,
  howSteps,
  testimonials,
  offerings,
  sampleHighlights,
  faqItems,
} from '../data/landingContent';
---
<BaseLayout
  title="Sporty — sports that fit your body"
  description=""
>
  <main>
    <section class="section-shell hero-shell" id="hero">
      <div class="hero__content">
        <span class="hero-badge" role="text">AI-driven matching of bodies and sports</span>
        <h1 class="hero-headline">Discover sports you are wired for</h1>
        <p class="hero-copy">
          Uncover activities where your body's unique build thrives — or help your child catch the early wins that grow lifelong confidence.
        </p>
        <div class="hero__actions">
          <a href="/intake" class="cta-primary nav-button hero-cta">Try free analysis</a>
          <a href="#tiers" class="cta-secondary nav-button hero-cta">Explore premium options</a>
        </div>
      </div>
      <figure class="hero-visual" aria-label="Watercolor illustration highlighting a multi-sport training scene.">
        <img
          data-image-key="landing.hero.banner"
          alt="Watercolor illustarating a person being measured ant other people in a park caught in training moments, all in a single panoramic scene."
          loading="lazy"
        />
      </figure>
    </section>

    <section class="section-shell section--accent" id="pillars" aria-labelledby="pillars-heading">
      <h2 class="section-title" id="pillars-heading">Why Sporty leads the match</h2>
      <div class="pillars-grid">
        {valuePillars.map((pillar) => (
          <article class="pillar-card">
            {pillar.imageKey ? (
              <figure class="pillar-art">
                <img data-image-key={pillar.imageKey} alt={pillar.imageAlt} loading="lazy" />
              </figure>
            ) : (
              <span class="pill-icon" aria-hidden="true">{pillar.icon}</span>
            )}
            <h3>{pillar.title}</h3>
            <p>{pillar.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section-shell process-section" id="how-it-works">
      <h2 class="section-title">How it works</h2>
      <p class="section-subtitle">Try your free analysis for adults today — no credit card required.</p>
      <div class="process">
        {howSteps.map((step, index) => (
          <article class="process__step">
            <span class="process__marker" aria-hidden="true">{index + 1}</span>
            <div class="process__body">
              <div class="process__text">
                <h3>{step.title}</h3>
                <p>{step.subtitle}</p>
              </div>
              {step.imageKey && (
                <figure class="process__media">
                  <img data-image-key={step.imageKey} alt={step.imageAlt} loading="lazy" />
                </figure>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section-shell testimonial-strip" aria-labelledby="testimonial-heading">
      <h2 class="section-title" id="testimonial-heading">People are already feeling the fit</h2>
      <div class="testimonial-strip__inner">
        {testimonials.map((item) => (
          <figure class="testimonial-card">
            <blockquote>{item.quote}</blockquote>
            <figcaption>{item.name}</figcaption>
          </figure>
        ))}
      </div>
    </section>

    <section class="section-shell" id="tiers">
      <h2 class="section-title">Pick the depth you need</h2>
      <p class="lead-copy">Start for free, then reach for adult or child credits when you want premium insights.</p>
      <div class="pricing-grid">
        {offerings.map((plan) => (
          <article class="card-shell plan-card">
            <div class="plan-card__ribbon">
              <span class="badge-subtle">{plan.ribbon}</span>
            </div>
            <h3 class="card-title">{plan.title}</h3>
            <p class="plan-price">{plan.price}</p>
            <p class="card-copy">{plan.summary}</p>
            <ul class="feature-list card-copy">
              {plan.features.map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
            <div class="btn-row">
              <a
                href={plan.cta.href}
                class={plan.cta.theme === 'primary' ? 'btn-primary' : 'btn-ghost'}
              >
                {plan.cta.label}
              </a>
              {plan.secondaryCta && (
                <a
                  href={plan.secondaryCta.href}
                  class={plan.secondaryCta.theme === 'primary' ? 'btn-primary' : 'btn-ghost'}
                >
                  {plan.secondaryCta.label}
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section-shell" id="sample-results">
      <h2 class="section-title">What premium-ready results look like</h2>
      <div class="grid-cards">
        {sampleHighlights.map((highlight) => (
          <article class="card-shell sample-card">
            <h3 class="card-title">{highlight.title}</h3>
            <figure class="image-tile">
              <img data-image-key={highlight.key} alt={highlight.alt} loading="lazy" />
            </figure>
            <p class="card-copy">{highlight.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section-shell section-narrow" id="why">
      <h2 class="section-title">Why body fit matters</h2>
      <p class="lead-copy">When your build aligns with a sport’s demands, skill work sticks faster and training feels better. Sporty ties anthropometric data to lived experience so you can invest reps where your body thrives.</p>
      <blockquote class="testimonial" aria-label="Founders quote">
        “Sporty demystifies how bodies, preferences, and performance factors interact. Whether you’re exploring sport for yourself or guiding a child, we highlight the activities that honour your strengths.”
        <footer>— Sporty Founders</footer>
      </blockquote>
    </section>

    <section class="section-shell" id="faq">
      <h2 class="section-title">Questions, answered</h2>
      <div class="faq-list">
        {faqItems.map((item) => (
          <details class="faq-item">
            <summary class="faq-item__summary">
              <span>{item.title}</span>
              <span aria-hidden="true">+</span>
            </summary>
            <div class="faq-item__content">
              <p>{item.content}</p>
            </div>
          </details>
        ))}
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <div>
        <strong>Sporty</strong>
        <p class="lead-copy">Helping every body find their sport. Unlimited free adult matches, $5 premium credits, and guardian-backed child insights.</p>
      </div>
      <nav class="footer-nav" aria-label="Footer">
        <a href="/intake">Start free</a>
        <a href="/pricing">Pricing</a>
        <a href="#faq">FAQ</a>
        <a href="/privacy">Privacy (draft)</a>
        <a href="/terms">Terms (draft)</a>
        <a href="mailto:hello@sporty.test">Contact</a>
      </nav>
      <small>© <span id="year">2025</span> Sporty. All rights reserved.</small>
    </div>
  </footer>

  <Fragment slot="scripts">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" defer></script>
    <script src="/config.js" defer></script>
    <script src="/assets/js/app.js" defer></script>
    <script src="/assets/js/landing.js" defer></script>
    <script>
      const yearEl = document.getElementById('year');
      if (yearEl) {
        yearEl.textContent = String(new Date().getFullYear());
      }
    </script>
  </Fragment>
</BaseLayout>
