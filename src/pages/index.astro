---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  valuePillars,
  howSteps,
  offerings,
  faqItems,
  scienceSection,
  scienceHighlights,
} from '../data/landingContent';
---
<BaseLayout
  title="Sporty — sports that fit your body"
  description=""
>
  <main>
    <section class="section-shell hero-shell" id="hero">
      <div class="hero__content">
        <span class="hero-badge">AI-driven matching of bodies and sports</span>
        <h1 class="hero-headline type-display">Discover sports you are wired for</h1>
        <p class="hero-copy type-lead">
          Uncover activities where your body's unique build thrives — or help your child catch the early wins that grow lifelong confidence.
        </p>
        <div class="hero__actions">
          <a href="/intake" class="btn-pill btn-pill-primary hero-cta">Try Quick Analysis</a>
          <a href="#tiers" class="btn-pill btn-pill-secondary hero-cta">Explore premium options</a>
        </div>
      </div>
      <figure class="hero-visual" aria-label="Watercolor illustration highlighting a multi-sport training scene.">
        <img
          class="h-full w-full object-cover"
          data-image-key="landing.hero.banner"
          alt="Watercolor illustration of a person being measured and other people in a park captured in training moments, all in a single panoramic scene."
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </section>

    <section class="section-shell" id="pillars" aria-labelledby="pillars-heading">
      <h2 class="section-title" id="pillars-heading">Why Sporty leads the match</h2>
      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {valuePillars.map((pillar) => (
          <article class="card-shell h-full">
            <figure class="overflow-hidden rounded-2xl bg-teal-100/20 aspect-square">
              <img
                class="h-full w-full object-cover"
                data-image-key={pillar.imageKey}
                alt={pillar.imageAlt}
                loading="lazy"
              />
            </figure>
            <h3 class="type-lead text-slate-900">{pillar.title}</h3>
            <p class="type-body">{pillar.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="section-shell" id="how-it-works">
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <div class="space-y-6">
          <h2 class="section-title">How it works</h2>
          <p class="section-subtitle">Try your quick analysis for adults today — no credit card required.</p>
          <div data-hs-stepper class="space-y-6">
            {howSteps.map((step, index, arr) => (
              <div>
                <div class="flex items-start gap-4" aria-label={`Step ${index + 1}`}>
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-teal-600 bg-teal-50 text-teal-700 font-semibold">{index + 1}</span>
                  <div class="space-y-1">
                    <h3 class="type-lead text-slate-900">{step.title}</h3>
                    <p class="type-body text-slate-600">{step.subtitle}</p>
                  </div>
                </div>
                {index < arr.length - 1 && (
                  <div class="ms-5 mt-3 h-10 border-l-2 border-dashed border-teal-200"></div>
                )}
              </div>
            ))}
          </div>
          <div>
            <a href="/intake" class="btn-pill btn-pill-primary">Try Quick Analysis</a>
          </div>
        </div>
        <figure class="relative overflow-hidden rounded-3xl bg-teal-100/40 aspect-[4/5] lg:aspect-square">
          <img
            data-image-key="landing.how_it_works.banner"
            alt="Illustration depicting the Sporty how-it-works journey."
            loading="lazy"
            class="h-full w-full object-cover"
          />
        </figure>
      </div>
    </section>

    <section class="section-shell scroll-mt-28" id="science">
      <div class="science-intro">
        <h2 class="section-title">{scienceSection.title}</h2>
        <p class="section-subtitle max-w-2xl">{scienceSection.copy}</p>
            <a
              href={scienceSection.cta.href}
              class="btn-pill btn-pill-secondary science-cta"
            >
              {scienceSection.cta.label}
            </a>
          </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {scienceHighlights.map((item) => (
          <article class="card-shell science-card">
            <iconify-icon icon={item.icon} class="icon-display" aria-hidden="true" />
            <h3 class="card-title">{item.title}</h3>
            <p class="card-copy">{item.copy}</p>
            <a
              href={item.cta.href}
              class="btn-pill btn-pill-secondary science-cta"
            >
              {item.cta.label}
            </a>
          </article>
        ))}
      </div>
    </section>

    {/*
    <section class="section-shell" aria-labelledby="testimonial-heading">
      <h2 class="section-title" id="testimonial-heading">People are already feeling the fit</h2>
      <div class="grid gap-6 md:grid-cols-2">
        {testimonials.map((item) => (
          <article class="card-shell h-full space-y-3">
            <blockquote class="type-lead text-slate-900 italic">{item.quote}</blockquote>
            <p class="type-body text-slate-600 font-semibold">{item.name}</p>
          </article>
        ))}
      </div>
    </section>
    */}

    <section class="section-shell scroll-mt-28" id="tiers">
      <h2 class="section-title">Pick the analysis you want</h2>
      <p class="lead-copy">Try a quick analysis right away. Or sign up and unlock deeper insights.</p>
      <div class="pricing-grid">
        {offerings.map((plan) => (
          <article class="card-shell plan-card">
            <div class="plan-card__ribbon">
              <span class="badge-subtle">{plan.ribbon}</span>
            </div>
            <h3 class="card-title">{plan.title}</h3>
            <p class="plan-price">{plan.price}</p>
            <p class="card-copy">{plan.summary}</p>
            <ul class="feature-list card-copy">
              {plan.features.map((feature) => (
                <li>{feature}</li>
              ))}
            </ul>
            <div class="btn-row">
              {plan.cta.kind ? (
                <button
                  type="button"
                  class={`btn-pill ${plan.cta.theme === 'primary' ? 'btn-pill-primary' : 'btn-pill-secondary'}`}
                  data-tier-cta
                  data-tier-kind={plan.cta.kind}
                >
                  {plan.cta.label}
                </button>
              ) : (
                <a
                  href={plan.cta.href}
                  class={`btn-pill ${plan.cta.theme === 'primary' ? 'btn-pill-primary' : 'btn-pill-secondary'}`}
                >
                  {plan.cta.label}
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section-shell" id="faq">
      <h2 class="section-title">Questions, answered</h2>
      <div class="hs-accordion-group space-y-4" data-hs-accordion='{"alwaysOpen": false}'>
        {faqItems.map((item, index) => {
          const headingId = `faq-accordion-${index}`;
          const panelId = `faq-panel-${index}`;
          return (
            <div class="hs-accordion overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm" id={headingId}>
              <button
                type="button"
                class="hs-accordion-toggle inline-flex w-full items-center gap-4 px-5 py-4 text-start transition hover:bg-slate-50 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-teal-500"
                aria-expanded="false"
                aria-controls={panelId}
              >
                <svg
                  class="h-5 w-5 shrink-0 text-slate-400 transition hs-accordion-active:rotate-90"
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke-width="1.5"
                  stroke="currentColor"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
                <span class="font-semibold text-slate-900">{item.title}</span>
              </button>
              <div
                id={panelId}
                class="hs-accordion-content hidden w-full overflow-hidden transition-[height] duration-300"
                aria-labelledby={headingId}
              >
                <div class="border-t border-slate-200 px-5 py-4 text-slate-600" set:html={item.content} />
              </div>
            </div>
          );
        })}
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="footer-inner">
      <div>
        <strong>Sporty</strong>
        <p class="lead-copy">Helping every body find their sport.</p>
      </div>
      <nav class="footer-nav" aria-label="Footer">
        <a href="/intake">Start free</a>
        <a href="/pricing">Pricing</a>
        <a href="#faq">FAQ</a>
        <a href="/privacy">Privacy (draft)</a>
        <a href="/terms">Terms (draft)</a>
        <a href="mailto:hello@sporty.test">Contact</a>
      </nav>
      <small>© <span id="year">2025</span> Sporty. All rights reserved.</small>
    </div>
  </footer>

  <Fragment slot="scripts">
    <script is:inline src="/assets/js/landing.js" defer></script>
    <script>
      const yearEl = document.getElementById('year');
      if (yearEl) {
        yearEl.textContent = String(new Date().getFullYear());
      }
    </script>
  </Fragment>
</BaseLayout>
