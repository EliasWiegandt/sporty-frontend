---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Sporty — Checkout Cancelled" description="Your Sporty checkout session was cancelled.">
  <main class="checkout-shell">
    <header>
      <p class="badge">Checkout</p>
      <h1>Checkout cancelled</h1>
      <p class="lead-copy">
        No worries—your card was not charged. You can restart the checkout whenever you’re ready.
      </p>
    </header>

    <section class="checkout-card">
      <p>
        Head back to the <a href="/pricing">pricing page</a> to try again or visit your
        <a href="/dashboard">dashboard</a> to use existing credits.
      </p>
      <p>
        Still seeing issues? Drop us a note using the feedback link in your dashboard.
      </p>
    </section>
  </main>
  <Fragment slot="scripts">
  </Fragment>
</BaseLayout>
