---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Sporty — Checkout Cancelled" description="Your Sporty checkout session was cancelled.">
  <main class="section-shell checkout-cancel">
    <header class="cancel-hero">
      <p class="badge">Checkout</p>
      <h1>Checkout cancelled</h1>
      <p class="lead-copy">
        No worries—your card was not charged. You can restart the checkout whenever you’re ready.
      </p>
    </header>

    <section class="card-shell cancel-card">
      <p>
        Head back to the <a href="/pricing">pricing page</a> to try again or visit your
        <a href="/dashboard">dashboard</a> to use existing credits.
      </p>
      <p>
        Still seeing issues? Drop us a note using the feedback link in your dashboard.
      </p>
    </section>
  </main>

  <Fragment slot="head">
    <style is:global>
      .checkout-cancel {
        max-width: min(720px, 90vw);
        margin: clamp(2rem, 6vw, 4rem) auto;
        padding: 0 clamp(1.5rem, 4vw, 3rem);
        display: grid;
        gap: clamp(1.5rem, 4vw, 2.5rem);
      }
      .cancel-hero .badge {
        display: inline-block;
        font-size: 0.85rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--teal-7);
      }
      .cancel-card {
        border-radius: 28px;
        border: 1px solid rgba(148, 163, 184, 0.25);
        background: linear-gradient(180deg, rgba(241, 245, 249, 0.45), rgba(255, 255, 255, 0.95));
        padding: clamp(1.75rem, 3vw, 2.25rem);
        display: grid;
        gap: 1rem;
      }
    </style>
  </Fragment>

  <Fragment slot="scripts">
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" defer></script>
    <script src="/config.js" defer></script>
    <script src="/assets/js/app.js" defer></script>
  </Fragment>
</BaseLayout>
