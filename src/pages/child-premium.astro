---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Sporty — Child Premium Analysis"
  description="Blend a child forecast with preferences, goals, injuries, and past sports to unlock premium matches."
>
  <main class="page">
    <section class="card-shell summary-card" data-premium-summary hidden>
      <div>
        <span class="badge">Forecast ready</span>
        <h1 class="section-title" style="margin:0;">Refine sport guidance</h1>
        <p class="lead-copy" data-premium-copy>
          Blend the projected adult body with tailored signals to unlock sport matches for this child.
        </p>
      </div>
      <div class="summary-grid" data-measurement-summary></div>
    </section>

    <div class="empty-state" data-premium-empty hidden>
      <h2>No forecast found</h2>
      <p>Run the child forecast first, then come back here to apply premium inputs.</p>
      <div class="actions btn-row justify-center">
        <a class="btn-primary" href="/child-intake">Go to child forecast</a>
      </div>
    </div>

    <form class="card-shell" data-child-premium-form hidden>
      <header class="grid">
        <div>
          <span class="coach-ribbon coach-ribbon--accent">Premium tailoring</span>
          <h2 class="section-title" style="margin:0;">Child sport alignment</h2>
          <p class="lead-copy">Guardian-only (under-18) flow. Add preferences, goals, injuries, and past sports. A paid child credit unlocks premium matches.</p>
        </div>
        <div class="toggle-row">
          <label class="toggle">
            <input type="checkbox" data-child-premium-apply checked />
            <span class="toggle__track"></span>
          </label>
          <div class="toggle-row__copy">
            <p class="toggle-row__title">Apply one child analysis credit</p>
            <p class="toggle-row__hint">Switch on to consume a credit and retrieve sport matches.</p>
          </div>
        </div>
      </header>

      <div class="status-area" data-status></div>

      <section class="premium-group" data-child-preferences>
        <header class="premium-group__header">
          <h3 style="margin:0;">Preferences</h3>
          <div class="premium-actions">
            <button type="button" class="btn-ghost btn-sm" data-add-preference>Add preference</button>
            <span class="premium-note" data-preference-count>0 / 10</span>
          </div>
        </header>
        <div class="premium-list" data-preference-list></div>
        <template data-preference-template>
          <div class="premium-item" data-item>
            <label class="field">
              <span class="field__label">Preference</span>
              <select class="input-base" data-field="preference_id" required></select>
            </label>
            <label class="field">
              <span class="field__label">Priority</span>
              <select class="input-base" data-field="priority">
                <option value="must_have">Must have</option>
                <option value="nice_to_have" selected>Nice to have</option>
              </select>
            </label>
            <button type="button" class="btn-ghost btn-sm" data-remove>Remove</button>
          </div>
        </template>
      </section>

      <section class="premium-group" data-child-goals>
        <header class="premium-group__header">
          <h3 style="margin:0;">Goals</h3>
          <div class="premium-actions">
            <button type="button" class="btn-ghost btn-sm" data-add-goal>Add goal</button>
            <span class="premium-note" data-goal-count>0 / 10</span>
          </div>
        </header>
        <div class="premium-list" data-goal-list></div>
        <template data-goal-template>
          <div class="premium-item" data-item>
            <label class="field">
              <span class="field__label">Goal</span>
              <select class="input-base" data-field="goal_id" required></select>
            </label>
            <label class="field">
              <span class="field__label">Priority</span>
              <select class="input-base" data-field="priority">
                <option value="must_have">Must have</option>
                <option value="nice_to_have" selected>Nice to have</option>
              </select>
            </label>
            <button type="button" class="btn-ghost btn-sm" data-remove>Remove</button>
          </div>
        </template>
      </section>

      <section class="premium-group" data-child-injuries>
        <header class="premium-group__header">
          <h3 style="margin:0;">Injury considerations</h3>
          <div class="premium-actions">
            <button type="button" class="btn-ghost btn-sm" data-add-injury>Add injury</button>
            <span class="premium-note" data-injury-count>0 / 10</span>
          </div>
        </header>
        <div class="premium-list" data-injury-list></div>
        <template data-injury-template>
          <div class="premium-item" data-item>
            <label class="field">
              <span class="field__label">Injury</span>
              <select class="input-base" data-field="injury_id" required></select>
            </label>
            <label class="field">
              <span class="field__label">Subcategory</span>
              <select class="input-base" data-field="injury_subcategory_id"></select>
            </label>
            <label class="field">
              <span class="field__label">Severity</span>
              <select class="input-base" data-field="severity">
                <option value="mostly_healed">Mostly healed</option>
                <option value="somewhat_bad" selected>Somewhat bad</option>
                <option value="severe">Severe</option>
              </select>
            </label>
            <label class="field">
              <span class="field__label">Notes (optional)</span>
              <input class="input-base" type="text" data-field="notes" placeholder="Recovery notes" />
            </label>
            <button type="button" class="btn-ghost btn-sm" data-remove>Remove</button>
          </div>
        </template>
      </section>

      <section class="premium-group" data-child-past>
        <header class="premium-group__header">
          <h3 style="margin:0;">Past sports</h3>
          <div class="premium-actions">
            <button type="button" class="btn-ghost btn-sm" data-child-past-add>Add sport</button>
            <span class="premium-note" data-child-past-count>0 / 5</span>
          </div>
        </header>
        <p class="lead-copy" data-child-past-empty>Sign in as a guardian to add child past sports.</p>
        <div class="premium-list" data-child-past-items></div>
        <template data-child-past-template>
          <div class="rounded-3xl border border-slate-200/80 bg-white px-4 py-5 shadow-sm space-y-4" data-item>
            <label class="space-y-2">
              <span class="type-body font-semibold text-slate-800">Sport or discipline</span>
              <div class="relative" data-picker>
                <input
                  type="text"
                  class="input-field"
                  data-field="sport_label"
                  placeholder="Search sports…"
                  autocomplete="off"
                />
                <input type="hidden" data-field="sport_subcategory_id" />
                <div
                  class="absolute inset-x-0 top-full z-20 mt-2 max-h-60 overflow-y-auto rounded-2xl border border-slate-200 bg-white shadow-lg hidden"
                  data-search-results
                  role="listbox"
                  aria-label="Sport suggestions"
                ></div>
              </div>
            </label>
            <div class="grid gap-4 md:grid-cols-2">
              <label class="space-y-2">
                <span class="type-body font-semibold text-slate-800">Years played</span>
                <input class="input-field" type="number" step="0.5" min="0" max="80" data-field="years_played" />
              </label>
              <label class="space-y-2">
                <span class="type-body font-semibold text-slate-800">Starting age</span>
                <input class="input-field" type="number" min="0" max="80" data-field="age_started_years" />
              </label>
            </div>
            <label class="space-y-2">
              <span class="type-body font-semibold text-slate-800">Intensity</span>
              <select class="input-field" data-field="intensity">
                <option value="">Select</option>
                <option value="light">Casual / recreational</option>
                <option value="moderate">Regular weekly sessions</option>
                <option value="intense">Competitive season</option>
                <option value="elite">High performance / elite</option>
              </select>
            </label>
            <div class="grid gap-4 md:grid-cols-3">
              <label class="space-y-2">
                <span class="type-body font-semibold text-slate-800">Enjoyed it?</span>
                <select class="input-field" data-field="liked">
                  <option value="">Select</option>
                  <option value="yes">Yes</option>
                  <option value="no">No</option>
                </select>
              </label>
              <label class="space-y-2">
                <span class="type-body font-semibold text-slate-800">Felt natural?</span>
                <select class="input-field" data-field="had_flair">
                  <option value="">Select</option>
                  <option value="yes">Yes</option>
                  <option value="no">No</option>
                </select>
              </label>
              <label class="space-y-2">
                <span class="type-body font-semibold text-slate-800">Became good?</span>
                <select class="input-field" data-field="achieved_skill">
                  <option value="">Select</option>
                  <option value="yes">Yes</option>
                  <option value="no">No</option>
                </select>
              </label>
            </div>
            <div class="flex justify-end">
              <button type="button" class="btn-pill btn-pill-secondary btn-pill-xs" data-remove>Remove</button>
            </div>
          </div>
        </template>
      </section>

      <div class="actions btn-row">
        <button type="submit" class="btn-primary" data-submit>Get sport matches</button>
        <a class="btn-ghost" href="/child-results">Back to forecast</a>
      </div>
    </form>
  </main>

  <Fragment slot="scripts">
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" defer></script>
    <script is:inline src="/config.js" defer></script>
    <script is:inline src="/assets/js/app.js?v=4" defer></script>
    <script is:inline src="/assets/js/child-premium.js" defer></script>
  </Fragment>
</BaseLayout>
