---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChildForecastApp from '../components/child/ChildForecastApp';

const adultGroups = ['18-20 years', '20-25 years', '25-35 years', '35-45 years'];
---
<BaseLayout
  title="Sporty — Child Forecast Intake"
  description="Project a child’s future body metrics using parent measurements and cohort data."
>
  <main class="mx-auto max-w-5xl space-y-10 pb-32">
    <div data-intake-root>
      <section class="section-shell space-y-8">
        <form id="child-intake-form" class="space-y-10" data-child-intake-form>
          <ChildForecastApp client:load adultAgeGroups={adultGroups} />
        </form>
      </section>
    </div>
  </main>

  <Fragment slot="scripts">
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" defer></script>
    <script is:inline src="/config.js" defer></script>
    <script is:inline src="/assets/js/app.js?v=6" defer></script>
  </Fragment>
</BaseLayout>
