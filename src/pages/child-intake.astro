---
import BaseLayout from '../layouts/BaseLayout.astro';

const adultGroups = [
  '18-20 years',
  '20-25 years',
  '25-35 years',
  '35-45 years',
];
---
<BaseLayout
  title="Sporty — Child Forecast Intake"
  description="Project a child’s future body metrics using parent measurements and cohort data."
>
  <Fragment slot="head">
    <style>
      .intake {
        max-width: 960px;
        margin: clamp(2rem, 4vw, 3.5rem) auto;
        display: grid;
        gap: 2rem;
        padding: 0 clamp(1.5rem, 5vw, 3rem);
      }
      .card {
        padding: clamp(1.5rem, 4vw, 2.5rem);
      }
      .lead {
        font-size: 1.05rem;
        color: var(--color-muted);
        margin: 0;
      }
      .grid {
        display: grid;
        gap: 1.25rem;
      }
      .input-row {
        display: grid;
        gap: 1rem;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      }
      label span {
        display: block;
        font-weight: 600;
        color: var(--color-text);
        margin-bottom: 0.35rem;
      }
      input,
      select {
        width: 100%;
        padding: 0.75rem 0.9rem;
        border-radius: 14px;
        border: 1px solid rgba(148, 163, 184, 0.45);
        background: #fff;
        font: inherit;
      }
      fieldset {
        border: 1px solid rgba(148, 163, 184, 0.35);
        border-radius: 16px;
        padding: clamp(1.25rem, 3vw, 1.75rem);
        display: grid;
        gap: 1rem;
      }
      fieldset legend {
        font-weight: 700;
        padding: 0 0.25rem;
      }
      .measurements {
        display: grid;
        gap: 0.9rem;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      }
      .banner {
        border-radius: 18px;
        padding: clamp(1.2rem, 3vw, 1.8rem);
        background: rgba(14, 165, 165, 0.12);
        border: 1px solid rgba(14, 165, 165, 0.25);
        color: var(--color-accent-dark);
      }
      .status-area {
        min-height: 2.2rem;
      }
      .status {
        border-radius: 14px;
        padding: 0.8rem 1rem;
        font-size: 0.95rem;
      }
      .status--error {
        background: rgba(239, 68, 68, 0.12);
        border: 1px solid rgba(239, 68, 68, 0.35);
        color: #b91c1c;
      }
      .status--info {
        background: rgba(37, 99, 235, 0.1);
        border: 1px solid rgba(37, 99, 235, 0.25);
        color: #1d4ed8;
      }
    </style>
  </Fragment>

  <main class="intake">
    <section class="banner" data-child-banner>
      Combine a child’s current measurements with parent data to project their adult body profile. Use the prefilled test family to validate the flow, or overwrite with your own numbers.
    </section>

    <form class="card grid" data-child-intake-form>
      <header>
        <h1 class="section__title" style="margin:0;">Child forecast intake</h1>
        <p class="lead">Provide age, optional ethnicity, and measurements for the child plus any available parent data.</p>
      </header>

      <section class="grid" aria-labelledby="who">
        <h2 id="who" class="section__subtitle" style="margin:0;">Who are we forecasting?</h2>
        <div class="input-row">
          <label>
            <span>Existing child ID</span>
            <input type="text" name="child_id" data-required placeholder="UUID from Supabase" />
          </label>
          <label>
            <span>Guardian user ID (optional)</span>
            <input type="text" name="guardian_user_id" placeholder="UUID of signed-in guardian" />
          </label>
          <label>
            <span>Birthdate</span>
            <input type="date" name="birthdate" data-required />
          </label>
          <label>
            <span>Sex</span>
            <select name="sex" data-required>
              <option value="female">Female</option>
              <option value="male">Male</option>
              <option value="other">Other</option>
              <option value="prefer_not">Prefer not to say</option>
            </select>
          </label>
          <label>
            <span>Ethnicity (optional)</span>
            <select name="ethnicity">
              <option value="">General population</option>
              <option value="caucasian">Caucasian</option>
              <option value="asian">Asian</option>
            </select>
          </label>
          <label>
            <span>Target adult cohort</span>
            <select name="adult_age_group">
              {adultGroups.map((group) => <option value={group}>{group}</option>)}
            </select>
          </label>
        </div>
      </section>

      <fieldset>
        <legend>Child measurements (cm)</legend>
        <div class="measurements">
          <label>
            <span>Height</span>
            <input type="number" step="0.1" name="child_height_cm" data-group="child" data-measurement="height_cm" required />
          </label>
          <label>
            <span>Arm span</span>
            <input type="number" step="0.1" name="child_arm_span_cm" data-group="child" data-measurement="arm_span_cm" />
          </label>
          <label>
            <span>Leg inseam</span>
            <input type="number" step="0.1" name="child_leg_inseam_cm" data-group="child" data-measurement="leg_inseam_cm" />
          </label>
          <label>
            <span>Shoulder width</span>
            <input type="number" step="0.1" name="child_shoulder_width_cm" data-group="child" data-measurement="shoulder_width_cm" />
          </label>
          <label>
            <span>Hip width</span>
            <input type="number" step="0.1" name="child_hip_width_cm" data-group="child" data-measurement="hip_width_cm" />
          </label>
          <label>
            <span>Hand length</span>
            <input type="number" step="0.1" name="child_hand_length_cm" data-group="child" data-measurement="hand_length_cm" />
          </label>
          <label>
            <span>Foot length</span>
            <input type="number" step="0.1" name="child_foot_length_cm" data-group="child" data-measurement="foot_length_cm" />
          </label>
        </div>
      </fieldset>

      <fieldset>
        <legend>Mother measurements (optional)</legend>
        <div class="measurements">
          <label>
            <span>Height</span>
            <input type="number" step="0.1" name="mother_height_cm" data-group="mother" data-measurement="height_cm" />
          </label>
          <label>
            <span>Arm span</span>
            <input type="number" step="0.1" name="mother_arm_span_cm" data-group="mother" data-measurement="arm_span_cm" />
          </label>
          <label>
            <span>Leg inseam</span>
            <input type="number" step="0.1" name="mother_leg_inseam_cm" data-group="mother" data-measurement="leg_inseam_cm" />
          </label>
          <label>
            <span>Shoulder width</span>
            <input type="number" step="0.1" name="mother_shoulder_width_cm" data-group="mother" data-measurement="shoulder_width_cm" />
          </label>
          <label>
            <span>Hip width</span>
            <input type="number" step="0.1" name="mother_hip_width_cm" data-group="mother" data-measurement="hip_width_cm" />
          </label>
          <label>
            <span>Hand length</span>
            <input type="number" step="0.1" name="mother_hand_length_cm" data-group="mother" data-measurement="hand_length_cm" />
          </label>
          <label>
            <span>Foot length</span>
            <input type="number" step="0.1" name="mother_foot_length_cm" data-group="mother" data-measurement="foot_length_cm" />
          </label>
        </div>
      </fieldset>

      <fieldset>
        <legend>Father measurements (optional)</legend>
        <div class="measurements">
          <label>
            <span>Height</span>
            <input type="number" step="0.1" name="father_height_cm" data-group="father" data-measurement="height_cm" />
          </label>
          <label>
            <span>Arm span</span>
            <input type="number" step="0.1" name="father_arm_span_cm" data-group="father" data-measurement="arm_span_cm" />
          </label>
          <label>
            <span>Leg inseam</span>
            <input type="number" step="0.1" name="father_leg_inseam_cm" data-group="father" data-measurement="leg_inseam_cm" />
          </label>
          <label>
            <span>Shoulder width</span>
            <input type="number" step="0.1" name="father_shoulder_width_cm" data-group="father" data-measurement="shoulder_width_cm" />
          </label>
          <label>
            <span>Hip width</span>
            <input type="number" step="0.1" name="father_hip_width_cm" data-group="father" data-measurement="hip_width_cm" />
          </label>
          <label>
            <span>Hand length</span>
            <input type="number" step="0.1" name="father_hand_length_cm" data-group="father" data-measurement="hand_length_cm" />
          </label>
          <label>
            <span>Foot length</span>
            <input type="number" step="0.1" name="father_foot_length_cm" data-group="father" data-measurement="foot_length_cm" />
          </label>
        </div>
      </fieldset>

      <div class="status-area" data-status></div>
      <div class="input-row" style="align-items:center;">
        <button class="button" type="submit" data-submit>Forecast future body</button>
        <button class="button--ghost" type="button" data-reset>Clear all</button>
        <a class="button--ghost" href="/child-results">View last forecast</a>
      </div>
    </form>
  </main>

  <Fragment slot="scripts">
    <script src="/assets/js/child-intake.js" defer></script>
  </Fragment>
</BaseLayout>
