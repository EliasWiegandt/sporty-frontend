---
import BaseLayout from '../layouts/BaseLayout.astro';
import IntakeApp from '../components/intake/IntakeApp';
import { measurementFields } from '../data/measurementFields';

const measurementMeta = measurementFields.map((field) => ({
  id: field.id,
  label: `${field.label} (${field.unit})`,
  unit: field.unit,
  min: field.min,
  max: field.max,
  step: field.step ?? 1,
}));
---
<BaseLayout
  title="Sporty — Premium adult intake"
  description="Log in, apply a credit, and share traits, goals, and injuries alongside your measurements."
>
  <main class="mx-auto max-w-5xl space-y-10 pb-32">
    <div class="space-y-6">
      <p class="type-lead text-teal-600">Premium analysis</p>
      <h1 class="type-display text-slate-900">Add the deep inputs that unlock a full Sporty story.</h1>
      <p class="text-slate-600">
        Capture your traits, preferences, goals, injuries, and past sports after applying a credit. Everything you enter here goes
        through the premium matching engine and saves to your account once you consent.
      </p>
    </div>
    <div data-intake-root>
      <section class="section-shell space-y-8">
        <form
          id="intake-form"
          class="space-y-10"
          data-intake-form
          data-measurements={JSON.stringify(measurementMeta)}
        >
          <IntakeApp client:load mode="premium" />

          <div class="space-y-4">
            <div data-status aria-live="polite"></div>
          </div>
        </form>
      </section>
    </div>
  </main>

  <Fragment slot="scripts">
    <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2" defer></script>
    <script is:inline src="/config.js" defer></script>
    <script is:inline src="/assets/js/app.js" defer></script>
  </Fragment>
</BaseLayout>
